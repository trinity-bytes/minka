---
/**
 * "Dale play": YouTube facade that only loads the player on click.
 * Defaults are the landing's presentation video; the about page passes its
 * own video and copy. Default slot: the section title (may contain <em>).
 */
import Icon from "../ui/Icon.astro";
import SectionHead from "../ui/SectionHead.astro";
import LandingSection from "./LandingSection.astro";

interface Props {
  id?: string;
  videoId?: string;
  eyebrow?: string;
  subtitle?: string;
  /** Visible facade label; also the base of the button/iframe names. */
  label?: string;
  /** Name of the video, used for the facade aria-label and iframe title. */
  videoTitle?: string;
}

const {
  id = "conoce-mas",
  videoId = "NzF1VfOuS4Y",
  eyebrow = "▶ Dale play",
  subtitle = "Mira cómo estamos transformando el intercambio y generando valor para todos.",
  label = "Ver video de presentación Mink'a",
  videoTitle = "Video de presentación Mink'a",
} = Astro.props;
const hasTitle = Astro.slots.has("default");
---

<LandingSection id={id}>
  <SectionHead eyebrow={eyebrow} eyebrowTone="green" subtitle={subtitle}>
    {hasTitle ? <slot /> : <Fragment>La propuesta <em>Mink'a</em>, en video</Fragment>}
  </SectionHead>
  <div class="video" data-reveal>
    <div class="video__ratio">
      <button
        type="button"
        class="video__facade"
        data-video-facade
        data-video-id={videoId}
        data-video-title={videoTitle}
        aria-label={`Reproducir ${videoTitle.charAt(0).toLowerCase()}${videoTitle.slice(1)}`}
      >
        <span class="video__play" aria-hidden="true">
          <Icon name="play" size={30} class="video__play-icon" />
        </span>
        <span class="video__label">{label}</span>
      </button>
    </div>
  </div>
</LandingSection>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-video-facade]").forEach((facade) => {
    facade.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube.com/embed/${facade.dataset.videoId}?autoplay=1`;
      iframe.title = facade.dataset.videoTitle ?? "Video de presentación Mink'a";
      iframe.style.cssText = "position:absolute;top:0;left:0;width:100%;height:100%;border:0;";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      facade.replaceWith(iframe);
    });
  });
</script>

<style>
  .video {
    max-width: 920px;
    margin: 0 auto;
    background: var(--color-card);
    border: var(--border-ink);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-hard-lg);
    padding: 18px;
    transform: rotate(-0.5deg);
  }

  .video__ratio {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border: var(--border-ink);
    border-radius: var(--radius-lg);
  }

  .video__facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    cursor: pointer;
    background:
      radial-gradient(closest-side, color-mix(in srgb, var(--color-primary-pop) 25%, transparent), transparent 75%),
      var(--color-ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    color: var(--color-paper);
  }

  .video__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    background: var(--color-primary-pop);
    border: var(--border-ink);
    border-radius: 50%;
    box-shadow: var(--shadow-hard-md);
    color: var(--color-on-brand);
    transition: transform 0.2s ease;
  }

  .video__facade:hover .video__play {
    transform: scale(1.1) rotate(-6deg);
  }

  .video__play .video__play-icon {
    margin-left: 6px;
  }

  .video__label {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 560;
    font-variation-settings:
      "SOFT" 100,
      "WONK" 1,
      "opsz" 40;
  }
</style>
