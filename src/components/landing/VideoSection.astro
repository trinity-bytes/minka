---
/** "Dale play": YouTube facade that only loads the player on click. */
import Icon from "../ui/Icon.astro";
import SectionHead from "../ui/SectionHead.astro";
import LandingSection from "./LandingSection.astro";

interface Props {
  videoId?: string;
}

const { videoId = "NzF1VfOuS4Y" } = Astro.props;
---

<LandingSection id="conoce-mas">
  <SectionHead
    eyebrow="▶ Dale play"
    eyebrowTone="green"
    subtitle="Mira cómo estamos transformando el intercambio y generando valor para todos."
  >
    La propuesta <em>Mink'a</em>, en video
  </SectionHead>
  <div class="video" data-reveal>
    <div class="video__ratio">
      <button
        type="button"
        class="video__facade"
        data-video-facade
        data-video-id={videoId}
        aria-label="Reproducir video de presentación Mink'a"
      >
        <span class="video__play" aria-hidden="true">
          <Icon name="play" size={30} class="video__play-icon" />
        </span>
        <span class="video__label">Ver video de presentación Mink'a</span>
      </button>
    </div>
  </div>
</LandingSection>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-video-facade]").forEach((facade) => {
    facade.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube.com/embed/${facade.dataset.videoId}?autoplay=1`;
      iframe.title = "Video de presentación Mink'a";
      iframe.style.cssText = "position:absolute;top:0;left:0;width:100%;height:100%;border:0;";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      facade.replaceWith(iframe);
    });
  });
</script>

<style>
  .video {
    max-width: 920px;
    margin: 0 auto;
    background: var(--color-card);
    border: var(--border-ink);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-hard-lg);
    padding: 18px;
    transform: rotate(-0.5deg);
  }

  .video__ratio {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border: var(--border-ink);
    border-radius: var(--radius-lg);
  }

  .video__facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    cursor: pointer;
    background:
      radial-gradient(closest-side, color-mix(in srgb, var(--color-primary-pop) 25%, transparent), transparent 75%),
      var(--color-ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    color: var(--color-paper);
  }

  .video__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 88px;
    height: 88px;
    background: var(--color-primary-pop);
    border: var(--border-ink);
    border-radius: 50%;
    box-shadow: var(--shadow-hard-md);
    color: var(--color-ink);
    transition: transform 0.2s ease;
  }

  .video__facade:hover .video__play {
    transform: scale(1.1) rotate(-6deg);
  }

  .video__play .video__play-icon {
    margin-left: 6px;
  }

  .video__label {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 560;
    font-variation-settings:
      "SOFT" 100,
      "WONK" 1,
      "opsz" 40;
  }
</style>
