---
/**
 * "Dale play": YouTube facade that only loads the player on click.
 * Defaults are the landing's presentation video; the about page passes its
 * own video and copy. Default slot: the section title (may contain <em>).
 *
 * Visual: the player sits in a solid mint bento frame (concentric radii);
 * the facade is an ink screen with a faint leaf watermark and a flat
 * brand-green play disc. Nothing moves except the play disc on hover.
 */
import Icon from "../ui/Icon.astro";
import SectionHead from "../ui/SectionHead.astro";
import Logomark from "../brand/Logomark.astro";
import LandingSection from "./LandingSection.astro";

interface Props {
  id?: string;
  /** Giant decorative folio number, passed through to LandingSection. */
  folio?: string;
  videoId?: string;
  eyebrow?: string;
  subtitle?: string;
  /** Visible facade label; also the base of the button/iframe names. */
  label?: string;
  /** Name of the video, used for the facade aria-label and iframe title. */
  videoTitle?: string;
}

const {
  id = "conoce-mas",
  videoId = "NzF1VfOuS4Y",
  eyebrow = "▶ Dale play",
  subtitle = "Mira cómo estamos transformando el intercambio y generando valor para todos.",
  label = "Ver video de presentación Mink'a",
  videoTitle = "Video de presentación Mink'a",
  folio,
} = Astro.props;
const hasTitle = Astro.slots.has("default");
---

<LandingSection id={id} folio={folio}>
  <SectionHead eyebrow={eyebrow} eyebrowTone="mint" subtitle={subtitle}>
    {hasTitle ? <slot /> : <Fragment>La propuesta <em>Mink'a</em>, en video</Fragment>}
  </SectionHead>
  <div class="video-stage">
    <div class="video" data-reveal>
      <div class="video__ratio">
        <button
          type="button"
          class="video__facade"
          data-video-facade
          data-video-id={videoId}
          data-video-title={videoTitle}
          aria-label={`Reproducir ${videoTitle.charAt(0).toLowerCase()}${videoTitle.slice(1)}`}
        >
          <Logomark tone="current" size={360} class="video__mark" />
          <span class="video__play" aria-hidden="true">
            <Icon name="play" size={34} class="video__play-icon" />
          </span>
          <span class="video__label">{label}</span>
        </button>
      </div>
    </div>
  </div>
</LandingSection>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-video-facade]").forEach((facade) => {
    facade.addEventListener("click", () => {
      const iframe = document.createElement("iframe");
      iframe.src = `https://www.youtube.com/embed/${facade.dataset.videoId}?autoplay=1`;
      iframe.title = facade.dataset.videoTitle ?? "Video de presentación Mink'a";
      iframe.style.cssText = "position:absolute;top:0;left:0;width:100%;height:100%;border:0;";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      facade.replaceWith(iframe);
    });
  });
</script>

<style>
  /* Mint bento frame; the screen radius = frame radius - frame padding. */
  .video {
    --frame-pad: clamp(12px, 1.8vw, 22px);
    max-width: 960px;
    margin: 0 auto;
    padding: var(--frame-pad);
    background: var(--color-mint);
    border-radius: var(--radius-bento);
  }

  .video__ratio {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: clip;
    border-radius: calc(var(--radius-bento) - var(--frame-pad));
    background: var(--color-ink);
  }

  .video__facade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: inherit;
    cursor: pointer;
    background: var(--color-ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(14px, 2.4vw, 24px);
    padding: 24px;
    color: var(--color-paper);
    overflow: clip;
  }

  /* The screen clips, so the focus ring is drawn inside it. */
  .video__facade:focus-visible {
    outline: 3px solid var(--color-brand);
    outline-offset: -8px;
  }

  /* Faint giant leaf behind the play disc (decorative). */
  .video__facade :global(.video__mark) {
    position: absolute;
    right: -6%;
    bottom: -22%;
    height: 112%;
    width: auto;
    color: var(--color-brand);
    opacity: 0.09;
    pointer-events: none;
  }

  .video__play {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: clamp(68px, 10vw, 104px);
    height: clamp(68px, 10vw, 104px);
    background: var(--color-brand);
    border-radius: var(--radius-full);
    color: var(--color-on-brand);
    transition: transform var(--dur-base) var(--ease-spring);
  }

  .video__facade:hover .video__play,
  .video__facade:focus-visible .video__play {
    transform: scale(1.08) rotate(-6deg);
  }

  /* Optical centering of the triangle glyph. */
  .video__play :global(.video__play-icon) {
    margin-left: 6%;
  }

  .video__label {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: var(--font-display-axes-text);
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  /* Scroll-driven expansion: the stage breaks out of the container to a
     near full-bleed width and starts scaled down to the static frame's size,
     growing to full width while it scrolls into the middle of the viewport.
     `scale` keeps layout still (no reflow on scroll); the reveal runs on the
     inner frame, so the two animations never share an element. Browsers
     without view timelines keep the static 960px frame. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .video-stage {
        /* Full-bleed minus gutters, capped so the 16:9 frame fits the viewport height. */
        --stage-width: min(1400px, 100vw - 2 * clamp(16px, 3vw, 40px), (100svh - 160px) * 16 / 9);
        --stage-from: 0.68;
        width: var(--stage-width);
        margin-inline: calc((100% - var(--stage-width)) / 2);
        transform-origin: 50% 0;
        animation: video-expand linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 45%;
      }

      .video-stage .video {
        max-width: none;
      }

      @keyframes video-expand {
        from {
          scale: var(--stage-from);
        }
        to {
          scale: 1;
        }
      }
    }
  }

  @media (max-width: 640px) {
    .video-stage {
      --stage-from: 0.88;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .video__facade:hover .video__play,
    .video__facade:focus-visible .video__play {
      transform: none;
    }
  }
</style>
