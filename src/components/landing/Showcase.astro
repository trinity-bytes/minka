---
/**
 * "La app por dentro": ink band with three phones showing real app screens
 * (home, listing detail, QR close), each tagged with a flat sticker, and the
 * Google Play badge below. Desktop fans the side phones inwards; below 860px
 * the phones become a swipeable scroll-snap carousel with position dots.
 */
import SectionHead from "../ui/SectionHead.astro";
import Sticker from "../ui/Sticker.astro";
import StoreBadge from "../ui/StoreBadge.astro";
import LandingSection from "./LandingSection.astro";
import PhoneFrame from "./PhoneFrame.astro";
import { INSTALL_HREF } from "../../lib/store";
import screenHome from "../../assets/images/landing/screen-inicio.png";
import screenDetail from "../../assets/images/landing/screen-detalle.png";
import screenQr from "../../assets/images/landing/screen-cierre-qr.png";

const phones = [
  {
    position: "side-l",
    sticker: { label: "Explora tu barrio", tone: "mint" },
    screen: screenHome,
    alt: "Inicio de la app Mink'a: buscador, categorías y trueques cerca de ti",
  },
  {
    position: "main",
    sticker: { label: "Propón un trueque", tone: "brand" },
    screen: screenDetail,
    alt: "Detalle de una bicicleta publicada, con el vecino verificado y el botón Proponer trueque",
  },
  {
    position: "side-r",
    sticker: { label: "Cierra con QR", tone: "paper" },
    screen: screenQr,
    alt: "Cierre del trueque: código QR para que el otro vecino lo escanee desde su app",
  },
] as const;
---

<LandingSection id="plataforma" folio="03" band="ink" class="showcase">
  <SectionHead
    eyebrow="La app por dentro"
    eyebrowTone="mint"
    subtitle="Así se ve Mink'a en tu celular: publica, encuentra y cierra trueques desde la app."
    inverse
  >
    Esto es <em>Mink'a</em> funcionando
  </SectionHead>
  <div class="phones" data-phones tabindex="0" role="region" aria-label="Pantallas de la app Mink'a">
    {
      phones.map((phone, i) => (
        <div
          class:list={["phones__item", `phones__item--${phone.position}`]}
          data-reveal
          style={i ? `--reveal-delay: ${i * 120}ms` : undefined}
        >
          <Sticker tone={phone.sticker.tone} class="phones__sticker">
            {phone.sticker.label}
          </Sticker>
          <PhoneFrame screen={phone.screen} alt={phone.alt} sizes="(max-width: 860px) 62vw, 312px" />
        </div>
      ))
    }
  </div>
  <div class="phones__dots" aria-hidden="true">
    {phones.map((_, i) => <span class:list={["phones__dot", i === 0 && "is-active"]} />)}
  </div>
  <div class="install">
    <StoreBadge theme="light" href={INSTALL_HREF} />
    <p class="install__note">Gratis · Android 8.0 o superior</p>
  </div>
</LandingSection>

<script>
  // Mark the dot of the phone most in view while the carousel scrolls.
  const track = document.querySelector<HTMLElement>("[data-phones]");
  const dots = document.querySelectorAll<HTMLElement>(".phones__dot");
  if (track && dots.length && "IntersectionObserver" in window) {
    const items = [...track.children];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = items.indexOf(entry.target);
          dots.forEach((dot, i) => dot.classList.toggle("is-active", i === index));
        }
      },
      { root: track, threshold: 0.6 },
    );
    items.forEach((item) => observer.observe(item));
  }
</script>

<style>
  .phones {
    display: grid;
    grid-template-columns: 1fr 1.07fr 1fr;
    gap: 36px;
    align-items: start;
    max-width: 1028px;
    margin: 0 auto;
  }

  .phones:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 8px;
    border-radius: var(--radius-lg);
  }

  .phones__item {
    position: relative;
  }

  .phones__item :global(.phone) {
    margin: 0 auto;
  }

  .phones__item--side-l,
  .phones__item--side-r {
    margin-top: 44px;
  }

  .phones__item--side-l :global(.phone),
  .phones__item--side-r :global(.phone) {
    width: 87%;
  }

  .phones__item--side-l :global(.phone) {
    transform: rotate(4deg);
  }

  .phones__item--side-r :global(.phone) {
    transform: rotate(-4deg);
  }

  .phones__item :global(.phones__sticker) {
    position: absolute;
    z-index: 1;
    top: 40px;
    right: -6px;
  }

  .phones__item--side-l :global(.phones__sticker) {
    --sticker-rotate: 6deg;
  }

  .phones__item--main :global(.phones__sticker) {
    --sticker-rotate: 4deg;
  }

  .phones__item--side-r :global(.phones__sticker) {
    --sticker-rotate: -5deg;
  }

  .phones__dots {
    display: none;
  }

  .install {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 20px;
    margin-top: 64px;
  }

  .install__note {
    margin: 0;
    font-size: 1rem;
    color: color-mix(in srgb, var(--color-paper) 75%, transparent);
  }

  /* === Phones: swipeable carousel === */
  @media (max-width: 860px) {
    .phones {
      --item: min(62vw, 260px);
      display: flex;
      gap: 20px;
      max-width: none;
      margin: 0 calc(50% - 50vw);
      padding: 10px calc(50vw - var(--item) / 2) 24px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .phones::-webkit-scrollbar {
      display: none;
    }

    .phones__item {
      flex: 0 0 var(--item);
      scroll-snap-align: center;
    }

    .phones__item--side-l,
    .phones__item--side-r {
      margin-top: 0;
    }

    .phones__item--side-l :global(.phone),
    .phones__item--side-r :global(.phone) {
      width: 100%;
      transform: none;
    }

    .phones__item :global(.phones__sticker) {
      top: 30px;
      right: -12px;
    }

    .phones__dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      margin-top: 8px;
    }

    .phones__dot {
      width: 8px;
      height: 8px;
      border-radius: var(--radius-full);
      background: color-mix(in srgb, var(--color-paper) 30%, transparent);
      transition:
        width 0.2s ease,
        background-color 0.2s ease;
    }

    .phones__dot.is-active {
      width: 24px;
      background: var(--color-brand);
    }

    .install {
      flex-direction: column;
      margin-top: 32px;
    }

    .install__note {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phones__dot {
      transition: none;
    }
  }
</style>
