---
/**
 * "La app por dentro": ink band with a carousel of real app screens captured
 * from the Android emulator, each phone tagged with a flat sticker, and the
 * Google Play badge below. The track is a full-bleed scroll-snap row: on
 * desktop it starts aligned with the content column and adds prev/next
 * buttons; below 860px each phone snaps to the center. Dots follow the phone
 * in focus and jump to any screen.
 */
import SectionHead from "../ui/SectionHead.astro";
import Sticker from "../ui/Sticker.astro";
import StoreBadge from "../ui/StoreBadge.astro";
import LandingSection from "./LandingSection.astro";
import PhoneFrame from "./PhoneFrame.astro";
import { INSTALL_HREF } from "../../lib/store";
import screenWelcome from "../../assets/images/landing/app-bienvenida.png";
import screenHome from "../../assets/images/landing/app-inicio.png";
import screenDetail from "../../assets/images/landing/app-detalle.png";
import screenSearch from "../../assets/images/landing/app-buscar.png";
import screenFilters from "../../assets/images/landing/app-filtros.png";
import screenPublish from "../../assets/images/landing/app-publicar.png";

const screens = [
  {
    sticker: { label: "Sin dinero", tone: "lavender" },
    screen: screenWelcome,
    alt: "Bienvenida de la app Mink'a: truequea lo que ya no usas, sin dinero",
  },
  {
    sticker: { label: "Explora tu barrio", tone: "mint" },
    screen: screenHome,
    alt: "Inicio de la app Mink'a: buscador, categorías y trueques cerca de ti",
  },
  {
    sticker: { label: "Mira el detalle", tone: "brand" },
    screen: screenDetail,
    alt: "Detalle de una publicación: fotos, estado, vecino que la ofrece y lo que busca a cambio",
  },
  {
    sticker: { label: "Busca por categoría", tone: "paper" },
    screen: screenSearch,
    alt: "Búsqueda con categorías: hogar, ropa, libros, tecnología, plantas y deportes",
  },
  {
    sticker: { label: "Filtra a tu medida", tone: "mint" },
    screen: screenFilters,
    alt: "Filtros de búsqueda por distancia, estado mínimo y orden",
  },
  {
    sticker: { label: "Publica en minutos", tone: "brand" },
    screen: screenPublish,
    alt: "Publicar un objeto: fotos, título, categoría y estado",
  },
] as const;

const tilts = ["5deg", "-4deg", "3deg"];
---

<LandingSection id="plataforma" folio="03" band="ink" class="showcase">
  <SectionHead
    eyebrow="La app por dentro"
    eyebrowTone="mint"
    subtitle="Capturas reales de la app: explora tu barrio, encuentra lo que buscas y publica tus cosas para truequear."
    inverse
  >
    Esto es <em>Mink'a</em> funcionando
  </SectionHead>
  <div class="carousel" data-carousel>
    <div class="carousel__track" data-carousel-track tabindex="0" role="region" aria-label="Pantallas de la app Mink'a">
      {
        screens.map((item, i) => (
          <div
            class="carousel__item"
            data-reveal
            style={`--reveal-delay: ${Math.min(i, 3) * 120}ms; --sticker-rotate: ${tilts[i % tilts.length]}`}
          >
            <Sticker tone={item.sticker.tone} class="carousel__sticker">
              {item.sticker.label}
            </Sticker>
            <PhoneFrame screen={item.screen} alt={item.alt} sizes="(max-width: 860px) 62vw, 280px" />
          </div>
        ))
      }
    </div>
    <div class="carousel__controls">
      <button class="carousel__arrow" type="button" data-carousel-prev aria-label="Pantalla anterior">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <div class="carousel__dots">
        {
          screens.map((_, i) => (
            <button
              class:list={["carousel__dot", i === 0 && "is-active"]}
              type="button"
              data-carousel-dot
              aria-label={`Ver pantalla ${i + 1} de ${screens.length}`}
              aria-current={i === 0 ? "true" : undefined}
            />
          ))
        }
      </div>
      <button class="carousel__arrow" type="button" data-carousel-next aria-label="Pantalla siguiente">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
  <div class="install">
    <StoreBadge theme="light" href={INSTALL_HREF} />
    <p class="install__note">Gratis · Android 8.0 o superior</p>
  </div>
</LandingSection>

<script>
  // Sync dots and arrows with the scroll position, and scroll on click.
  const root = document.querySelector<HTMLElement>("[data-carousel]");
  const track = root?.querySelector<HTMLElement>("[data-carousel-track]");
  if (root && track) {
    const items = [...track.children] as HTMLElement[];
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-carousel-dot]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const centered = window.matchMedia("(max-width: 860px)");
    let active = 0;

    // Scroll offset at which an item sits at its snap position.
    const snapLeft = (item: HTMLElement) => {
      const padding = parseFloat(getComputedStyle(track).scrollPaddingInlineStart) || 0;
      return centered.matches
        ? item.offsetLeft - (track.clientWidth - item.offsetWidth) / 2
        : item.offsetLeft - padding;
    };

    const goTo = (index: number) => {
      const target = items[Math.max(0, Math.min(items.length - 1, index))];
      track.scrollTo({ left: snapLeft(target), behavior: reduceMotion.matches ? "auto" : "smooth" });
    };

    const update = () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      const atEnd = track.scrollLeft >= maxScroll - 2;
      let closest = 0;
      let best = Infinity;
      items.forEach((item, i) => {
        const distance = Math.abs(snapLeft(item) - track.scrollLeft);
        if (distance < best) {
          best = distance;
          closest = i;
        }
      });
      // Desktop shows several phones: once the track can't scroll further,
      // the last dot is the honest answer.
      active = atEnd && !centered.matches ? items.length - 1 : closest;
      dots.forEach((dot, i) => {
        dot.classList.toggle("is-active", i === active);
        if (i === active) dot.setAttribute("aria-current", "true");
        else dot.removeAttribute("aria-current");
      });
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = atEnd;
    };

    let frame = 0;
    track.addEventListener(
      "scroll",
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
      },
      { passive: true },
    );
    window.addEventListener("resize", update, { passive: true });
    dots.forEach((dot, i) => dot.addEventListener("click", () => goTo(i)));
    prev?.addEventListener("click", () => goTo(active - 1));
    next?.addEventListener("click", () => goTo(active + 1));
    track.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        goTo(active + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        goTo(active - 1);
      }
    });
    update();
  }
</script>

<style>
  .carousel {
    --item: 280px;
    --edge: max(24px, calc((100vw - 1028px) / 2));
  }

  .carousel__track {
    display: flex;
    gap: 40px;
    margin: 0 calc(50% - 50vw);
    padding: 16px var(--edge) 32px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__track:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: -4px;
    border-radius: var(--radius-lg);
  }

  .carousel__item {
    position: relative;
    flex: 0 0 var(--item);
    padding-top: 12px;
    scroll-snap-align: start;
  }

  .carousel__item :global(.carousel__sticker) {
    position: absolute;
    z-index: 1;
    top: 36px;
    right: -14px;
  }

  .carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-top: 8px;
  }

  .carousel__arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    color: var(--color-paper);
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--color-paper) 35%, transparent);
    border-radius: var(--radius-full);
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      opacity 0.2s ease,
      scale 0.15s ease;
  }

  .carousel__arrow svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .carousel__arrow:active:not(:disabled) {
    scale: 0.94;
  }

  .carousel__arrow:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .carousel__arrow:focus-visible,
  .carousel__dot:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  @media (hover: hover) {
    .carousel__arrow:hover:not(:disabled) {
      background: color-mix(in srgb, var(--color-paper) 12%, transparent);
      border-color: var(--color-paper);
    }
  }

  .carousel__dots {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  /* 8px dot with a 24px hit area. */
  .carousel__dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
    transition: width 0.2s ease;
  }

  .carousel__dot::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-paper) 30%, transparent);
    transition:
      width 0.2s ease,
      background-color 0.2s ease;
  }

  .carousel__dot.is-active {
    width: 36px;
  }

  .carousel__dot.is-active::before {
    width: 24px;
    background: var(--color-brand);
  }

  .install {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 20px;
    margin-top: 56px;
  }

  .install__note {
    margin: 0;
    font-size: 1rem;
    color: color-mix(in srgb, var(--color-paper) 75%, transparent);
  }

  /* === Phones: one centered phone per snap === */
  @media (max-width: 860px) {
    .carousel {
      --item: min(62vw, 260px);
    }

    .carousel__track {
      gap: 20px;
      padding: 10px calc(50vw - var(--item) / 2) 24px;
    }

    .carousel__item {
      scroll-snap-align: center;
    }

    .carousel__item :global(.carousel__sticker) {
      top: 30px;
      right: -12px;
    }

    .carousel__arrow {
      display: none;
    }

    .install {
      flex-direction: column;
      margin-top: 32px;
    }

    .install__note {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__arrow,
    .carousel__dot,
    .carousel__dot::before {
      transition: none;
    }
  }
</style>
