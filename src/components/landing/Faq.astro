---
/**
 * "Preguntas frecuentes": the objections people raise before installing,
 * answered with what the rest of the landing already promises. Native
 * exclusive accordion (<details name>): one answer open at a time, no JS,
 * keyboard and screen-reader support for free. Where `::details-content`
 * and `interpolate-size` exist, answers slide open; elsewhere they snap.
 */
import SectionHead from "../ui/SectionHead.astro";
import LandingSection from "./LandingSection.astro";

const questions = [
  {
    q: "¿Cuánto cuesta usar Mink'a?",
    a: "Nada. La app es gratis y no necesitas dinero para intercambiar: ofreces lo que ya no usas a cambio de algo que sí te sirve.",
  },
  {
    q: "¿Qué puedo intercambiar?",
    a: "Objetos y servicios: ropa, libros, electrónica, muebles, herramientas y más. Publicas con fotos y los vecinos interesados te proponen un trueque.",
  },
  {
    q: "¿Cómo sé que puedo confiar en el otro vecino?",
    a: "Mink'a es una comunidad de vecinos verificados y puedes chatear con la otra persona antes de aceptar. Para el encuentro, elige siempre un lugar público.",
  },
  {
    q: "¿Dónde y cómo se hace el intercambio?",
    a: "Lo coordinan por el chat de la app. Al encontrarse, cierran el trueque escaneando el código QR de Mink'a y ambos ganan eco-puntos.",
  },
  {
    q: "¿En qué zonas funciona?",
    a: "En Lima. La app te muestra primero los trueques cerca de ti, para que intercambies sin cruzar la ciudad.",
  },
  {
    q: "¿Hay versión para iPhone?",
    a: "Por ahora Mink'a está disponible solo para Android 8.0 o superior.",
  },
];
---

<LandingSection id="preguntas" folio="07" compactTop>
  <SectionHead
    eyebrow="Preguntas frecuentes"
    eyebrowTone="lavender-soft"
    subtitle="Lo que casi todos preguntan antes de su primer trueque."
  >
    ¿Dudas? <em>Resueltas</em>
  </SectionHead>

  <div class="faq">
    {
      questions.map(({ q, a }, i) => (
        <details
          class="faq__item"
          name="faq"
          open={i === 0}
          data-reveal
          style={`--reveal-delay: ${i * 70}ms`}
        >
          <summary class="faq__question">
            <span>{q}</span>
            <span class="faq__toggle" aria-hidden="true" />
          </summary>
          <p class="faq__answer">{a}</p>
        </details>
      ))
    }
  </div>
</LandingSection>

<style>
  .faq {
    display: grid;
    gap: 12px;
    max-width: 820px;
    margin: 0 auto;
  }

  .faq__item {
    background: var(--color-card);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-md);
    transition: box-shadow var(--dur-base) var(--ease-standard);
  }

  .faq__item[open] {
    box-shadow: var(--shadow-lift);
  }

  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 22px 22px 28px;
    border-radius: inherit;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-variation-settings: var(--font-display-axes-text);
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:focus-visible {
    outline: 3px solid var(--color-brand);
    outline-offset: 3px;
  }

  /* Plus drawn with two bars on a mint disc; the vertical bar folds away
     (plus -> minus) and the disc turns brand green when open. */
  .faq__toggle {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-mint);
    transition:
      background-color var(--dur-base) var(--ease-standard),
      rotate var(--dur-slow) var(--ease-spring);
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: "";
    position: absolute;
    inset: 50% auto auto 50%;
    width: 14px;
    height: 2px;
    margin: -1px 0 0 -7px;
    border-radius: 2px;
    background: var(--color-ink);
    transition: scale var(--dur-base) var(--ease-standard);
  }

  .faq__toggle::after {
    rotate: 90deg;
  }

  .faq__item[open] .faq__toggle {
    background: var(--color-brand);
    rotate: 180deg;
  }

  .faq__item[open] .faq__toggle::after {
    scale: 0 1;
  }

  .faq__question:hover .faq__toggle {
    background: var(--color-brand);
  }

  .faq__answer {
    margin: 0;
    padding: 0 84px 24px 28px;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--color-ink-2);
    text-wrap: pretty;
  }

  @supports (interpolate-size: allow-keywords) {
    @media (prefers-reduced-motion: no-preference) {
      .faq__item {
        interpolate-size: allow-keywords;
      }

      .faq__item::details-content {
        block-size: 0;
        overflow: clip;
        transition:
          block-size var(--dur-slow) var(--ease-out),
          content-visibility var(--dur-slow) allow-discrete;
      }

      .faq__item[open]::details-content {
        block-size: auto;
      }
    }
  }

  @media (max-width: 640px) {
    .faq__question {
      padding: 18px 16px 18px 20px;
    }

    .faq__answer {
      padding: 0 20px 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__toggle,
    .faq__toggle::before,
    .faq__toggle::after {
      transition: none;
    }
  }
</style>
