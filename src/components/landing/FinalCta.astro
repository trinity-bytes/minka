---
/**
 * Final call to action as a bold closing bento block: lavender fill with
 * violet ink (no green on lavender), a giant faint leaf watermark, a
 * word-by-word headline, the Google Play badge, the selling points split
 * into flat stickers and the Android requirement. This is the #descargar
 * target of every install link, so its badge is a static label until the
 * listing exists (src/lib/store.ts). Defaults are the landing copy; the
 * default slot overrides the title (may contain <em>, rendered as a plain
 * heading). `small` = "" hides the stickers, `requirement` = "" the
 * requirement line. Nothing loops: the words rise once on reveal.
 */
import Sticker from "../ui/Sticker.astro";
import StoreBadge from "../ui/StoreBadge.astro";
import WordReveal from "../ui/WordReveal.astro";
import Logomark from "../brand/Logomark.astro";
import LandingSection from "./LandingSection.astro";
import { PLAY_STORE_URL } from "../../lib/store";

interface Props {
  subtitle?: string;
  small?: string;
  requirement?: string;
}

const {
  subtitle = "Descarga Mink'a gratis en Android y empieza a intercambiar hoy. Tu próximo tesoro está a una cuadra de distancia.",
  small = "Gratis en Android ✶ Comunidad verificada ✶ Hecho en Lima",
  requirement = "Requiere Android 8.0 o superior",
} = Astro.props;
const hasTitle = Astro.slots.has("default");

// "A ✶ B ✶ C" becomes three stickers; text without separators stays one.
const notes = small
  .split("✶")
  .map((note) => note.trim())
  .filter(Boolean);
const TILTS = ["-3deg", "2deg", "-1.5deg"];
---

<LandingSection id="descargar" class="closing">
  <div class="cta" data-reveal>
    <Logomark tone="current" size={520} class="cta__mark" />
    <div class="cta__body">
      {
        hasTitle ? (
          <h2 class="cta__title display">
            <slot />
          </h2>
        ) : (
          <WordReveal text="¿Listo para hacer *girar* tus cosas?" class="cta__title display" />
        )
      }
      <p class="cta__subtitle">{subtitle}</p>
      <div class="cta__action">
        <StoreBadge href={PLAY_STORE_URL ?? undefined} />
      </div>
      {
        notes.length > 0 && (
          <ul class="cta__notes" role="list">
            {notes.map((note, i) => (
              <li>
                <Sticker tone="paper" style={`--sticker-rotate: ${TILTS[i % TILTS.length]}`}>
                  {note}
                </Sticker>
              </li>
            ))}
          </ul>
        )
      }
      {requirement && <p class="cta__requirement">{requirement}</p>}
    </div>
  </div>
</LandingSection>

<style>
  .cta {
    position: relative;
    overflow: clip;
    padding: clamp(56px, 8vw, 110px) clamp(24px, 5vw, 72px);
    border-radius: var(--radius-bento);
    background: var(--color-lavender);
    /* Re-point ink so every descendant (title, button, stickers) uses violet. */
    --color-ink: var(--color-on-lavender);
    --logo-leaf: var(--color-on-lavender);
    color: var(--color-ink);
    text-align: center;
  }

  /* Giant faint leaf, cropped by the block's bottom-right corner. */
  .cta :global(.cta__mark) {
    position: absolute;
    right: -8%;
    bottom: -30%;
    height: 130%;
    width: auto;
    color: var(--color-on-lavender);
    opacity: 0.1;
    pointer-events: none;
  }

  .cta__body {
    position: relative;
    max-width: 780px;
    margin: 0 auto;
  }

  .cta__title {
    font-size: clamp(2.2rem, 4.6vw, 3.5rem);
    margin: 0 0 24px;
    color: var(--color-ink);
    text-wrap: balance;
    word-spacing: 0.06em;
    /* Key word: medium violet, 4.06:1 on lavender (large display text). */
    --word-key-color: var(--color-lavender-ink);
    --word-key-tint: var(--color-lavender);
  }

  .cta__title :global(em) {
    color: var(--color-lavender-ink);
  }

  .cta__subtitle {
    font-size: 1.19rem;
    line-height: 1.6;
    color: var(--color-ink);
    max-width: 600px;
    margin: 0 auto 28px;
    text-wrap: pretty;
  }

  /* Ink is re-pointed to violet in this block; the badge keeps a forest
     pill (deep ink) as everywhere else. */
  .cta__action :global(.store-badge--dark) {
    background: var(--color-ink-deep);
  }

  .cta__requirement {
    margin: 28px 0 0;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--color-ink);
  }

  .cta__notes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 14px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 640px) {
    .cta :global(.cta__mark) {
      right: -30%;
      bottom: -12%;
      height: 70%;
    }
  }

  :global(body.high-contrast) .cta {
    outline: 2px solid var(--color-hc-ink);
    outline-offset: -2px;
  }

  :global(body.high-contrast) .cta__title {
    --word-key-color: var(--color-hc-ink);
  }

  :global(body.high-contrast) .cta__title :global(em) {
    color: var(--color-hc-ink);
  }
</style>
