---
/**
 * Final call to action as a bold closing bento block: lavender fill with
 * violet ink (no green on lavender), a giant faint leaf watermark, a
 * word-by-word headline and the fine print split into flat stickers.
 * Defaults are the landing copy; the default slot overrides the title
 * (may contain <em>, rendered as a plain heading). `small` = "" hides the
 * fine print. Nothing loops: the words rise once on reveal.
 */
import Button from "../ui/Button.astro";
import Sticker from "../ui/Sticker.astro";
import WordReveal from "../ui/WordReveal.astro";
import Logomark from "../brand/Logomark.astro";
import LandingSection from "./LandingSection.astro";
import { url } from "../../lib/url";

interface Props {
  subtitle?: string;
  ctaLabel?: string;
  ctaHref?: string;
  small?: string;
}

const {
  subtitle = "Crea tu cuenta y empieza a intercambiar hoy. Tu próximo tesoro está a una cuadra de distancia.",
  ctaLabel = "Crear mi cuenta",
  ctaHref = url("pages/auth.html"),
  small = "Sin tarjeta ✶ Comunidad verificada ✶ Hecho en Lima",
} = Astro.props;
const hasTitle = Astro.slots.has("default");

// "A ✶ B ✶ C" becomes three stickers; text without separators stays one.
const notes = small
  .split("✶")
  .map((note) => note.trim())
  .filter(Boolean);
const TILTS = ["-3deg", "2deg", "-1.5deg"];
---

<LandingSection class="closing">
  <div class="cta" data-reveal>
    <Logomark tone="current" size={520} class="cta__mark" />
    <div class="cta__body">
      {
        hasTitle ? (
          <h2 class="cta__title display">
            <slot />
          </h2>
        ) : (
          <WordReveal text="¿Listo para hacer *girar* tus cosas?" class="cta__title display" />
        )
      }
      <p class="cta__subtitle">{subtitle}</p>
      <div class="cta__action">
        <Button href={ctaHref} variant="ink">{ctaLabel}</Button>
      </div>
      {
        notes.length > 0 && (
          <ul class="cta__notes" role="list">
            {notes.map((note, i) => (
              <li>
                <Sticker tone="paper" style={`--sticker-rotate: ${TILTS[i % TILTS.length]}`}>
                  {note}
                </Sticker>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</LandingSection>

<style>
  .cta {
    position: relative;
    overflow: clip;
    padding: clamp(56px, 8vw, 110px) clamp(24px, 5vw, 72px);
    border-radius: var(--radius-bento);
    background: var(--color-lavender);
    /* Re-point ink so every descendant (title, button, stickers) uses violet. */
    --color-ink: var(--color-on-lavender);
    --logo-leaf: var(--color-on-lavender);
    color: var(--color-ink);
    text-align: center;
  }

  /* Giant faint leaf, cropped by the block's bottom-right corner. */
  .cta :global(.cta__mark) {
    position: absolute;
    right: -8%;
    bottom: -30%;
    height: 130%;
    width: auto;
    color: var(--color-on-lavender);
    opacity: 0.1;
    pointer-events: none;
  }

  .cta__body {
    position: relative;
    max-width: 780px;
    margin: 0 auto;
  }

  .cta__title {
    font-size: clamp(2.5rem, 6.4vw, 5.2rem);
    margin: 0 0 24px;
    color: var(--color-ink);
    text-wrap: balance;
    word-spacing: 0.06em;
    /* Key word: medium violet, 4.06:1 on lavender (large display text). */
    --word-key-color: var(--color-lavender-ink);
    --word-key-tint: var(--color-lavender);
  }

  .cta__title :global(em) {
    color: var(--color-lavender-ink);
  }

  .cta__subtitle {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-ink);
    max-width: 560px;
    margin: 0 auto 36px;
    text-wrap: pretty;
  }

  .cta__notes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 14px;
    margin: 34px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 640px) {
    .cta :global(.cta__mark) {
      right: -30%;
      bottom: -12%;
      height: 70%;
    }
  }

  :global(body.high-contrast) .cta {
    outline: 2px solid var(--color-hc-ink);
    outline-offset: -2px;
  }

  :global(body.high-contrast) .cta__title {
    --word-key-color: var(--color-hc-ink);
  }

  :global(body.high-contrast) .cta__title :global(em) {
    color: var(--color-hc-ink);
  }
</style>
