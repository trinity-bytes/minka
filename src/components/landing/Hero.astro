---
/**
 * Landing hero, organic language: poster headline revealed word by word,
 * the Google Play badge plus a "how it works" pill and a stats row of icon
 * chips on the left; on the right a mint stage whose blob-cropped photo
 * bleeds off the card edge, with a phone showing the app home screen, a
 * smaller blob photo, flat stickers and a "neighbours" card overlapping it.
 * Nothing loops, so no pause control is needed here (the ribbon below has
 * its own).
 */
import Avatar from "../ui/Avatar.astro";
import BlobMedia from "../ui/BlobMedia.astro";
import Button from "../ui/Button.astro";
import Icon from "../ui/Icon.astro";
import IconChip from "../ui/IconChip.astro";
import StoreBadge from "../ui/StoreBadge.astro";
import Sticker from "../ui/Sticker.astro";
import WordReveal from "../ui/WordReveal.astro";
import PhoneFrame from "./PhoneFrame.astro";
import { Picture } from "astro:assets";
import { INSTALL_HREF } from "../../lib/store";
import bike from "../../assets/images/hero/bicicleta-vintage.jpg";
import books from "../../assets/images/hero/set-libros.jpg";
import screenHome from "../../assets/images/landing/screen-inicio.png";

const stats = [
  { value: "1,250+", label: "trueques", icon: "swap", tone: "brand" },
  { value: "750+", label: "vecinos", icon: "people", tone: "lavender" },
  { value: "500 kg", label: "menos residuos", icon: "leaf", tone: "mint" },
] as const;

const neighbours = ["Lucía Quispe", "Diego Huamán", "Rosa Mamani"];
---

<section class="hero" id="inicio">
  <div class="hero__grid">
    <div class="hero__content">
      <Sticker tone="mint" class="hero__eyebrow" data-reveal>La comunidad de trueque de Lima</Sticker>
      <WordReveal
        as="h1"
        class="hero__title display"
        text="Intercambia *ropa*, *libros* o *muebles* y haz que Lima gire."
        delay={120}
      />
      <p class="hero__subtitle" data-reveal style="--reveal-delay: 420ms">
        Descarga la app, publica lo que ya no usas y conecta con vecinos verificados para
        intercambiar sin gastar un sol. Ahorro real para ti, menos residuos para la ciudad.
      </p>
      <div class="hero__cta" data-reveal style="--reveal-delay: 520ms">
        <StoreBadge href={INSTALL_HREF} />
        <Button href="#como-funciona" variant="outline" size="sm">
          <Icon name="arrow-down" size={18} />
          Ver cómo funciona
        </Button>
      </div>
      <ul class="hero__stats" data-reveal style="--reveal-delay: 620ms">
        {
          stats.map((stat) => (
            <li class="hero__stat">
              <IconChip icon={stat.icon} tone={stat.tone} size="sm" />
              <span>
                <b>{stat.value}</b> {stat.label}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero__visual">
      <div class="hero__stage">
        <!-- LCP image: static (no reveal), eager, high priority. -->
        <BlobMedia shape="a" ratio="1.12" class="hero__bike">
          <Picture
            src={bike}
            formats={["avif", "webp"]}
            widths={[480, 720, 960, 1280]}
            sizes="(max-width: 900px) 100vw, 640px"
            loading="eager"
            fetchpriority="high"
            alt="Bicicleta urbana vintage publicada para trueque en Mink'a"
          />
        </BlobMedia>
      </div>

      <BlobMedia
        src={books}
        alt="Set de libros usados en buen estado"
        shape="c"
        ratio="1"
        widths={[200, 400]}
        sizes="200px"
        class="hero__books"
        data-reveal
        style="--reveal-delay: 300ms"
      />
      <PhoneFrame
        screen={screenHome}
        alt="Pantalla de inicio de la app Mink'a con buscador, categorías y trueques cerca de ti"
        sizes="(max-width: 900px) 52vw, 260px"
        loading="eager"
        class="hero__phone"
        data-reveal
        style="--reveal-delay: 420ms"
      />

      <Sticker tone="ink" class="hero__sticker hero__sticker--free" data-reveal style="--reveal-delay: 640ms">
        Gratis en Android
      </Sticker>
      <Sticker tone="brand" class="hero__sticker hero__sticker--direct" data-reveal style="--reveal-delay: 760ms">
        Directo con vecinos
      </Sticker>

      <div class="hero__neighbours" data-reveal style="--reveal-delay: 860ms">
        <span class="hero__avatars">
          {neighbours.map((name) => <Avatar name={name} size="sm" decorative />)}
        </span>
        <span class="hero__neighbours-text">
          <b>750+ vecinos</b>
          <span>verificados en Lima</span>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: min(100svh, 1000px);
    padding: clamp(96px, 12svh, 124px) 0 clamp(40px, 6svh, 72px);
  }

  .hero__grid {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 4.5vw, 72px);
    align-items: center;
  }

  /* === Copy === */
  .hero__content :global(.hero__eyebrow) {
    --sticker-rotate: -3deg;
  }

  .hero__content :global(.hero__title) {
    /* Width and height aware so the hero fits 1440x900 without scrolling. */
    font-size: clamp(2.7rem, min(5.7vw, 9.4svh), 5.6rem);
    margin: 22px 0 22px;
    max-width: 12ch;
    --word-key-tint: var(--color-paper);
  }

  .hero__subtitle {
    font-size: clamp(1.02rem, 1.2vw, 1.14rem);
    line-height: 1.6;
    color: var(--color-ink-2);
    max-width: 34rem;
    margin: 0 0 28px;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-bottom: 28px;
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__stat {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.95rem;
    color: var(--color-ink-2);
  }

  .hero__stat b {
    color: var(--color-ink);
    font-weight: 800;
  }

  /* === Visual === */
  .hero__visual {
    position: relative;
    height: clamp(440px, calc(100svh - 210px), 660px);
  }

  .hero__stage {
    position: absolute;
    inset: 0 0 0 9%;
    border-radius: var(--radius-bento);
    background: var(--color-mint);
    /* Clip so the main blob bleeds off the card edge. */
    overflow: clip;
  }

  .hero__stage :global(.hero__bike) {
    position: absolute;
    width: 104%;
    right: -22%;
    bottom: -17%;
  }

  .hero__stage :global(.hero__bike img) {
    object-position: 62% 60%;
  }

  .hero__visual :global(.hero__books),
  .hero__visual :global(.hero__phone) {
    position: absolute;
    z-index: 1;
  }

  .hero__visual :global(.hero__books) {
    width: 30%;
    top: 0;
    left: 0;
    transform: rotate(8deg);
  }

  /* Sized by height (82% of the visual) so it fits short viewports too. */
  .hero__visual :global(.hero__phone) {
    top: 13.6%;
    left: 17%;
    height: 82%;
  }

  .hero__visual :global(.hero__sticker) {
    position: absolute;
    z-index: 2;
  }

  .hero__visual :global(.hero__sticker--free) {
    top: 6%;
    right: 5%;
    --sticker-rotate: -6deg;
  }

  .hero__visual :global(.hero__sticker--direct) {
    left: 3%;
    bottom: 5%;
    --sticker-rotate: -5deg;
  }

  .hero__neighbours {
    position: absolute;
    z-index: 2;
    right: 2%;
    bottom: 3%;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 18px 12px 12px;
    background: var(--color-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transform: rotate(-2deg);
  }

  .hero__avatars {
    display: flex;
  }

  .hero__avatars :global(.avatar) {
    outline: 3px solid var(--color-card);
  }

  .hero__avatars :global(.avatar + .avatar) {
    margin-left: -10px;
  }

  .hero__neighbours-text {
    display: grid;
    line-height: 1.25;
    font-size: 0.85rem;
    color: var(--color-ink-2);
  }

  .hero__neighbours-text b {
    font-size: 0.98rem;
    color: var(--color-ink);
  }

  /* === Tablet: stack, visual below the copy === */
  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-top: 112px;
    }

    .hero__grid {
      grid-template-columns: 1fr;
      padding: 0 24px;
      gap: 56px;
    }

    .hero__content :global(.hero__title) {
      font-size: clamp(2.7rem, 9vw, 4.4rem);
    }

    .hero__visual {
      width: 100%;
      max-width: 560px;
      height: auto;
      aspect-ratio: 358 / 460;
      margin: 0 auto;
    }

    .hero__stage {
      inset: 0;
    }

    .hero__visual :global(.hero__books) {
      width: 38%;
      top: 3%;
      left: 2%;
    }

    .hero__visual :global(.hero__phone) {
      top: 8.7%;
      left: 23.2%;
      width: 53.6%;
      height: auto;
    }

    .hero__visual :global(.hero__sticker--direct) {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding-top: 100px;
    }

    .hero__grid {
      padding: 0 16px;
      gap: 44px;
    }

    .hero__content :global(.hero__title) {
      margin: 18px 0;
    }

    .hero__cta {
      gap: 8px;
    }

    .hero__cta :global(.store-badge) {
      width: 100%;
      justify-content: center;
    }

    .hero__cta :global(.btn--outline) {
      border-color: transparent;
      padding-inline: 12px;
    }

    .hero__visual :global(.hero__sticker--free) {
      right: 0;
    }

    .hero__neighbours {
      right: 3%;
      bottom: 4%;
      padding: 8px 12px 8px 8px;
    }

    .hero__neighbours-text span {
      display: none;
    }
  }
</style>
