---
/**
 * "Cómo funciona": three solid-color step cards that stack while scrolling.
 * Each list item is `position: sticky` with an incremental top offset, so
 * the next card slides over the previous one. Where scroll-driven animations
 * are supported (and motion is allowed), covered cards recede: they scale
 * down slightly and dim, driven by the list's view timeline. Small or short
 * viewports and reduced motion get a plain vertical list.
 *
 * Each card shows a photo cropped by a blob (BlobMedia); the glyph disc sits
 * as a small accent overlapping the blob edge. `focus` is the photo's
 * object-position so the subject survives the crop (photos are not square).
 */
import type { ImageMetadata } from "astro";
import BlobMedia from "../ui/BlobMedia.astro";
import SectionHead from "../ui/SectionHead.astro";
import LandingSection from "./LandingSection.astro";
import publicaFoto from "../../assets/images/how-it-works/publica-foto.jpg";
import conectaVecinos from "../../assets/images/how-it-works/conecta-vecinos.jpg";
import intercambiaManos from "../../assets/images/how-it-works/intercambia-manos.jpg";

interface Step {
  tone: "ink" | "lavender" | "brand";
  title: string;
  text: string;
  /** Stroke glyph paths (24x24, currentColor). */
  glyph: string[];
  photo: {
    src: ImageMetadata;
    alt: string;
    shape: "a" | "b" | "c";
    /** Width / height of the blob box; also sizes it by the card height. */
    ratio: number;
    /** object-position focal point. */
    focus: string;
  };
}

const steps: Step[] = [
  {
    tone: "ink",
    title: "Publica tu oferta",
    text: "Sube fotos de lo que ya no uses: ropa, libros, electrónica, muebles. Dale una segunda vida a tus cosas.",
    glyph: ["M3.5 8.5h3.2l1.8-2.8h7l1.8 2.8h3.2v10.8h-17z", "M12 16.6a3.3 3.3 0 1 0 0-6.6 3.3 3.3 0 0 0 0 6.6z"],
    photo: {
      src: publicaFoto,
      alt: "Mujer fotografiando con su celular unas piezas de cerámica para publicarlas",
      shape: "a",
      ratio: 1.08,
      focus: "60% 50%",
    },
  },
  {
    tone: "lavender",
    title: "Conecta con vecinos",
    text: "Explora ofertas cerca de ti, chatea con otros usuarios y encuentra el intercambio perfecto para ambos.",
    glyph: ["M3.5 4.5h12v8.5H9l-3.8 3v-3H3.5z", "M18.5 8.5h2v8.5h-1.7v3l-3.8-3H11v-1.5"],
    photo: {
      src: conectaVecinos,
      alt: "Dos vecinos se encuentran en la vereda; él sonríe con suéter verde y gorro amarillo",
      shape: "b",
      ratio: 0.92,
      focus: "68% 38%",
    },
  },
  {
    tone: "brand",
    title: "Intercambia y celebra",
    text: "Coordina el encuentro, completa el trueque y gana eco-puntos. Así cuidamos el planeta juntos.",
    glyph: ["M4 8h15.5", "M15.5 4l4 4-4 4", "M20 16H4.5", "M8.5 12l-4 4 4 4"],
    photo: {
      src: intercambiaManos,
      alt: "Dos manos se pasan un celular amarillo sobre un fondo rojo",
      shape: "c",
      ratio: 1,
      focus: "50% 45%",
    },
  },
];
---

<LandingSection id="como-funciona" folio="01">
  <SectionHead
    eyebrow="Así de fácil"
    eyebrowTone="amber"
    subtitle="Sin vueltas: publicas, conectas e intercambias. El círculo se cierra y todos ganan."
  >
    Tres pasos y ya estás <em>truequeando</em>
  </SectionHead>

  <ol class="stack" role="list" style={`--cards: ${steps.length}`}>
    {
      steps.map((step, i) => {
        const num = String(i + 1).padStart(2, "0");
        return (
          <li class="stack__item" style={`--i: ${i}`}>
            <article class:list={["step-card", `step-card--${step.tone}`]} aria-labelledby={`paso-${num}`}>
              <div class="step-card__body">
                <p class="step-card__kicker">Paso {num}</p>
                <h3 class="step-card__title" id={`paso-${num}`}>
                  {step.title}
                </h3>
                <p class="step-card__text">{step.text}</p>
              </div>
              <div class="step-card__visual">
                <span class="step-card__numeral" aria-hidden="true">
                  {num}
                </span>
                <div
                  class="step-card__photo"
                  style={`--photo-ratio: ${step.photo.ratio}; --photo-focus: ${step.photo.focus}`}
                >
                  <BlobMedia
                    src={step.photo.src}
                    alt={step.photo.alt}
                    shape={step.photo.shape}
                    ratio={String(step.photo.ratio)}
                    widths={[320, 480, 640, 880]}
                    sizes="(max-width: 640px) 90vw, (max-width: 900px) 280px, 420px"
                    loading="lazy"
                  />
                  <span class="step-card__disc" aria-hidden="true">
                    <svg viewBox="0 0 24 24" focusable="false">
                      {step.glyph.map((d) => (
                        <path d={d} />
                      ))}
                    </svg>
                  </span>
                </div>
              </div>
            </article>
          </li>
        );
      })
    }
  </ol>
</LandingSection>

<style>
  .stack {
    /* Sticky geometry: first card sticks just below the floating header,
       each following card a step lower so the previous edges stay visible. */
    --stack-top: 104px;
    --stack-step: 22px;
    /* Tallest a sticky card may be under the stacked offsets. */
    --card-max: calc(100svh - var(--stack-top) - var(--cards) * var(--stack-step) - 24px);
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 7vh;
  }

  .stack__item {
    position: sticky;
    top: calc(var(--stack-top) + var(--i) * var(--stack-step));
    /* Deeper cards end slightly smaller than the ones above them. */
    --recede-scale: calc(1 - (var(--cards) - 1 - var(--i)) * 0.045);
  }

  .step-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    align-items: center;
    gap: 32px;
    /* Never taller than the space left under the stacked offsets. */
    --card-pad: clamp(32px, 4.4vw, 64px);
    min-height: min(30rem, var(--card-max));
    padding: var(--card-pad);
    border-radius: var(--radius-bento);
    background: var(--card-bg);
    color: var(--card-fg);
    transform-origin: 50% 0;
    /* Clip the giant numeral to the card. */
    overflow: clip;
  }

  /* Palette pairs: paper on ink, on-lavender on lavender, on-brand on green. */
  .step-card--ink {
    --card-bg: var(--color-ink);
    --card-fg: var(--color-paper);
    --card-muted: color-mix(in srgb, var(--color-paper) 80%, var(--color-ink));
    --card-accent: var(--color-brand);
    --disc-bg: var(--color-brand);
    --disc-fg: var(--color-on-brand);
  }

  .step-card--lavender {
    --card-bg: var(--color-lavender);
    --card-fg: var(--color-on-lavender);
    --card-muted: var(--color-on-lavender);
    --card-accent: var(--color-on-lavender);
    --disc-bg: var(--color-on-lavender);
    --disc-fg: var(--color-lavender);
  }

  .step-card--brand {
    --card-bg: var(--color-brand);
    --card-fg: var(--color-on-brand);
    --card-muted: var(--color-on-brand);
    --card-accent: var(--color-on-brand);
    --disc-bg: var(--color-card);
    --disc-fg: var(--color-ink);
  }

  .step-card__body {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .step-card__kicker {
    margin: 0;
    padding: 6px 14px;
    border: 1.5px solid currentColor;
    border-radius: var(--radius-chip);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--card-accent);
  }

  .step-card__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-variation-settings: var(--font-display-axes);
    font-size: clamp(2.3rem, 4.6vw, 4.2rem);
    line-height: var(--font-display-leading);
    letter-spacing: var(--font-display-tracking);
    word-spacing: 0.06em;
    color: inherit;
    text-wrap: balance;
  }

  .step-card__text {
    margin: 0;
    max-width: 32rem;
    font-size: 1.12rem;
    line-height: 1.55;
    color: var(--card-muted);
    text-wrap: pretty;
  }

  .step-card__visual {
    position: relative;
    display: grid;
    place-items: center;
    align-self: stretch;
  }

  .step-card__numeral {
    position: absolute;
    right: -0.06em;
    bottom: -0.2em;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-variation-settings: var(--font-display-axes);
    font-size: clamp(9rem, 19vw, 17rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--card-fg);
    opacity: 0.12;
    user-select: none;
  }

  /* Photo box: sized by the column and by the card's height budget, so the
     blob never pushes a sticky card past the viewport. */
  .step-card__photo {
    position: relative;
    z-index: 1;
    width: min(100%, 420px, calc((var(--card-max) - 2 * var(--card-pad)) * var(--photo-ratio)));
  }

  .step-card__photo :global(img) {
    object-position: var(--photo-focus);
  }

  /* Step 03's coral backdrop: tone it down a touch next to the brand green. */
  .step-card--brand .step-card__photo :global(img) {
    filter: saturate(0.82);
  }

  /* Glyph disc: small accent overlapping the blob's lower-left edge. */
  .step-card__disc {
    position: absolute;
    left: -4%;
    bottom: 4%;
    display: grid;
    place-items: center;
    width: clamp(72px, 7.5vw, 104px);
    aspect-ratio: 1;
    border: 4px solid var(--card-bg);
    border-radius: var(--radius-full);
    background: var(--disc-bg);
    color: var(--disc-fg);
  }

  .step-card__disc svg {
    width: 46%;
    height: 46%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  :global(body.high-contrast) .step-card {
    outline: 2px solid var(--color-hc-ink);
    outline-offset: -2px;
  }

  @media (forced-colors: active) {
    .step-card,
    .step-card__disc {
      border: 2px solid CanvasText;
    }
  }

  /* Covered cards recede (scale + dim) across the list's exit-crossing:
     card i animates during its slice i/N..(i+1)/N, which is when the next
     card slides over it. The last card never recedes. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 641px) and (min-height: 621px) {
      .stack {
        view-timeline: --steps-stack block;
      }

      .stack__item:not(:last-child) .step-card {
        /* Longhands on purpose: the CSS minifier folds `animation` +
           `animation-timeline` into one shorthand that browsers reject. */
        animation-name: step-recede;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: --steps-stack;
        animation-range:
          exit-crossing calc(var(--i) / var(--cards) * 100%)
          exit-crossing calc((var(--i) + 1) / var(--cards) * 100%);
      }
    }
  }

  @keyframes step-recede {
    to {
      scale: var(--recede-scale);
      filter: brightness(0.82);
    }
  }

  @media (max-width: 900px) {
    .step-card {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 24px;
    }

    .step-card__numeral {
      display: none;
    }

    /* The `auto` column needs an explicit width. */
    .step-card__photo {
      width: min(clamp(200px, 30vw, 280px), calc((var(--card-max) - 2 * var(--card-pad)) * var(--photo-ratio)));
    }
  }

  /* Phones, short viewports and reduced motion: a plain list. Cards keep
     their colors but do not stick, so none can exceed the viewport. */
  @media (max-width: 640px), (max-height: 620px), (prefers-reduced-motion: reduce) {
    .stack {
      gap: 16px;
      /* Nothing sticks, so the height budget no longer limits the photo. */
      --card-max: 60rem;
    }

    .stack__item {
      position: static;
    }

    .step-card {
      min-height: 0;
    }
  }

  @media (max-width: 640px) {
    .step-card {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      padding: 28px 24px 30px;
      border-radius: var(--radius-card);
    }

    .step-card__visual {
      order: -1;
    }

    /* Wider, shorter crop on phones keeps the text close to the photo. */
    .step-card__photo {
      width: 100%;
      max-width: 420px;
    }

    .step-card .step-card__photo :global(.blob-media) {
      aspect-ratio: 4 / 3;
    }

    .step-card__disc {
      left: 0;
      bottom: -6px;
      width: 64px;
      border-width: 3px;
    }

    .step-card__title {
      font-size: clamp(2rem, 9vw, 2.5rem);
    }

    .step-card__text {
      font-size: 1rem;
    }
  }
</style>
