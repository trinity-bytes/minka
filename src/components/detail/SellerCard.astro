---
/**
 * Owner line of the detail page (T10d-1): a plain row on the page, no card.
 * Initials avatar, "Publicado por" + name, rating and location, and a text
 * link to the owner's profile. Name, location, rating, the avatar initials
 * and tint (#seller-avatar) and the profile href are filled in by
 * src/scripts/pages/detail.js. The avatar uses the page-level
 * `.seller-avatar--<tone>` classes (detail.css) so the script can retint it.
 */
import { url } from "../../lib/url";
import { avatarTone, initials } from "../../scripts/lib/avatar.js";

const PLACEHOLDER = "Usuario Demo";
---

<section class="seller-card" aria-labelledby="seller-title">
  <h2 class="sr-only" id="seller-title" data-i18n="detail_publisher">Publicador</h2>
  <div class="seller">
    <span
      class:list={["seller-avatar", `seller-avatar--${avatarTone(PLACEHOLDER)}`]}
      id="seller-avatar"
      aria-hidden="true">{initials(PLACEHOLDER)}</span
    >
    <div class="seller__info">
      <span class="seller__by"><span data-i18n="detail_posted_by">Publicado por</span> <strong id="seller-name">{PLACEHOLDER}</strong></span>
      <span class="seller__meta">
        <span id="seller-rating"><i class="fas fa-star" aria-hidden="true"></i> 4.5</span>
        <span aria-hidden="true">·</span>
        <span id="seller-location">Lima, Perú</span>
      </span>
    </div>
    <a class="seller__link" href={url("pages/perfil.html")} id="owner-profile-link">
      <span data-i18n="detail_view_profile">Ver perfil</span>
      <i class="fas fa-arrow-right" aria-hidden="true"></i>
    </a>
  </div>
</section>
