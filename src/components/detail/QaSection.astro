---
/**
 * Public Q&A under a listing (T12): neighbors ask, the owner and other
 * neighbors reply (one level), owner posts carry an "Autor" badge. Plain
 * comment rows split by hairlines, unboxed on the page (not a card stack,
 * not chat bubbles). Threads are rendered by src/scripts/lib/qa-view.js;
 * the templates below let it clone the shared Avatar and Badge with their
 * scoped styles. Guests see a sign-in prompt instead of the form.
 */
import Avatar from "../ui/Avatar.astro";
import Badge from "../ui/Badge.astro";
import EmptyState from "../ui/EmptyState.astro";
import { url } from "../../lib/url";
import { QA_MAX_LENGTH } from "../../scripts/lib/qa.js";
---

<section class="container qa" id="qa" aria-labelledby="qa-title">
  <div class="qa__head">
    <h2 id="qa-title">Preguntas</h2>
    <p class="qa__count" id="qa-count"></p>
  </div>

  <form class="qa-form qa-form--ask" id="qa-ask-form" novalidate hidden>
    <label class="qa-form__label" for="qa-ask-text">Pregunta al dueño o a los vecinos</label>
    <textarea
      id="qa-ask-text"
      name="text"
      rows="3"
      placeholder="Escribe tu pregunta sobre este objeto"
      aria-describedby="qa-ask-count qa-ask-error"
      data-max={QA_MAX_LENGTH}></textarea>
    <div class="qa-form__foot">
      <p class="qa-form__error" id="qa-ask-error" hidden></p>
      <span class="qa-form__count" id="qa-ask-count">0 / {QA_MAX_LENGTH}</span>
      <button class="btn btn-primary" type="submit">Publicar pregunta</button>
    </div>
  </form>

  <p class="qa-login" id="qa-login" hidden>
    <i class="fas fa-lock" aria-hidden="true"></i>
    <span>Inicia sesión para preguntar o responder.</span>
    <a id="qa-login-link" href={url("pages/auth.html")}>Iniciar sesión</a>
  </p>

  <ol class="qa-list" id="qa-list" role="list" aria-labelledby="qa-title"></ol>

  <div class="qa-empty" id="qa-empty" hidden>
    <EmptyState
      variant="compact"
      icon="fa-comments"
      title="Todavía no hay preguntas"
      text="Pregunta lo que necesites saber antes de proponer un trueque."
      headingLevel={3}
    />
  </div>

  <p class="sr-only" id="qa-status" role="status"></p>

  <template id="qa-avatar-tpl"><Avatar name="?" size="sm" decorative /></template>
  <template id="qa-badge-tpl"><Badge tone="ink" class="qa-post__badge">Autor</Badge></template>
</section>
