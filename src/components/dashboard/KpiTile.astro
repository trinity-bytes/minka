---
/**
 * Dashboard KPI tile: IconChip + value, unit and label on a white rounded
 * card (visual language T10b). The value (#`valueId`) is animated by
 * src/scripts/pages/dashboard.js.
 */
import IconChip from "../ui/IconChip.astro";

interface Props {
  /** Color family of the icon chip. */
  tone: "co2" | "water" | "objects";
  /** Font Awesome solid icon name, e.g. "fa-cloud". */
  icon: string;
  valueId: string;
  unit: string;
  label: string;
}

const { tone, icon, valueId, unit, label } = Astro.props;
const CHIP_TONE = { co2: "brand", water: "lavender", objects: "mint" } as const;
---

<div class="kpi-card">
  <IconChip tone={CHIP_TONE[tone]} class="kpi-icon">
    <i class:list={["fas", icon]}></i>
  </IconChip>
  <div class="kpi-content">
    <p class="kpi-figure">
      <span class="kpi-value" id={valueId}>0</span>
      <span class="kpi-unit">{unit}</span>
    </p>
    <span class="kpi-label">{label}</span>
  </div>
</div>

<style>
  .kpi-card {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-20) var(--space-24);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .kpi-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
  }

  .kpi-figure {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    margin: 0;
    line-height: 1;
  }

  .kpi-value {
    color: var(--color-ink);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .kpi-unit {
    color: var(--color-ink-2);
    font-size: 1rem;
    font-weight: 700;
  }

  .kpi-label {
    color: var(--color-ink-2);
    font-size: 0.9rem;
    font-weight: 600;
  }

  :global(body.high-contrast) .kpi-card {
    background: var(--color-hc-paper);
    outline: 2px solid var(--color-hc-ink);
  }

  :global(body.high-contrast) .kpi-value,
  :global(body.high-contrast) .kpi-unit,
  :global(body.high-contrast) .kpi-label {
    color: var(--color-hc-ink);
  }

  @media (forced-colors: active) {
    .kpi-card {
      border: 1px solid CanvasText;
    }
  }
</style>
