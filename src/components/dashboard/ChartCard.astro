---
/**
 * Titled card holding one Chart.js canvas (#`canvasId`), drawn by
 * src/scripts/pages/dashboard.js. The container fixes the chart height.
 * Visual language (T10b): white rounded card, Inter 800 title (h2: the
 * page title is the only h1).
 */
interface Props {
  title: string;
  /** i18n key for the title (legacy I18n runtime). */
  titleKey?: string;
  canvasId: string;
}

const { title, titleKey, canvasId } = Astro.props;
---

<div class="chart-card">
  <h2 data-i18n={titleKey}>{title}</h2>
  <div class="chart-container">
    <canvas id={canvasId} role="img" aria-label={title}></canvas>
  </div>
</div>

<style>
  .chart-card {
    min-width: 0;
    padding: var(--space-24);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .chart-card h2 {
    margin: 0 0 var(--space-16);
    color: var(--color-ink);
    font-family: var(--font-primary);
    font-size: 1.15rem;
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .chart-container {
    position: relative;
    height: 300px;
    width: 100%;
  }

  :global(body.high-contrast) .chart-card {
    background: var(--color-hc-paper);
    outline: 2px solid var(--color-hc-ink);
  }

  :global(body.high-contrast) .chart-card h2 {
    color: var(--color-hc-ink);
  }

  @media (forced-colors: active) {
    .chart-card {
      border: 1px solid CanvasText;
    }
  }

  @media (max-width: 480px) {
    .chart-card {
      padding: var(--space-16);
    }

    .chart-container {
      height: 260px;
    }
  }
</style>
