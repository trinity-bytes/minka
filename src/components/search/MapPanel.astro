---
/**
 * Reference map (static demo image): the last group of the search filter
 * column, closed by default so it never pushes the filters down (T10d-2).
 * Styles live in src/styles/pages/search.css.
 */
import { Picture } from "astro:assets";
import map from "../../assets/images/mapa-ejemplo-minka.png";
---

<details class="filter-group map-panel">
  <summary class="filter-group__summary">
    <span>Mapa de distritos</span>
    <i class="fas fa-chevron-down filter-group__chevron" aria-hidden="true"></i>
  </summary>
  <div class="filter-group__body">
    <p class="map-panel__desc">Se muestran los distritos de referencia según la distancia.</p>
    <Picture
      src={map}
      formats={["avif", "webp"]}
      widths={[320, 640]}
      sizes="(max-width: 768px) 100vw, 280px"
      alt="Mapa referencial"
      class="map-panel__image"
      loading="lazy"
    />
  </div>
</details>
