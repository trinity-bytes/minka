---
/**
 * One collapsible filter group of the search filter column (T10d-2): a
 * native <details> whose summary is the group heading with a chevron, open
 * by default. The control goes in the default slot and keeps a (visually
 * hidden) <label> pointing at it. Styles live in
 * src/styles/pages/search.css.
 */
interface Props {
  /** id of the control the label points at. */
  for: string;
  label: string;
  /** i18n key for the label (legacy I18n runtime). */
  labelKey?: string;
  open?: boolean;
}

const { for: controlId, label, labelKey, open = true } = Astro.props;
---

<details class="filter-group" open={open}>
  <summary class="filter-group__summary">
    <span data-i18n={labelKey}>{label}</span>
    <i class="fas fa-chevron-down filter-group__chevron" aria-hidden="true"></i>
  </summary>
  <div class="filter-group__body">
    <label class="sr-only" for={controlId} data-i18n={labelKey}>{label}</label>
    <slot />
  </div>
</details>
