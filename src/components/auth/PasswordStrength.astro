---
/**
 * Password strength meter. src/scripts/pages/auth.js sets the fill width
 * and the weak | medium | strong modifier classes on input.
 */
---

<div class="password-strength" id="password-strength">
  <div class="password-strength__bar">
    <div class="password-strength__fill"></div>
  </div>
  <span class="password-strength__label"></span>
</div>

<style>
  .password-strength {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .password-strength__bar {
    width: 100%;
    height: 8px;
    overflow: hidden;
    border-radius: var(--radius-full);
    background: var(--color-paper-2);
  }

  .password-strength__fill {
    width: 0%;
    height: 100%;
    border-radius: var(--radius-full);
    background: var(--color-gray-300);
  }

  @media (prefers-reduced-motion: no-preference) {
    .password-strength__fill {
      transition:
        width 0.3s ease,
        background-color 0.3s ease;
    }
  }

  .password-strength__fill.weak {
    background: var(--color-error);
  }

  .password-strength__fill.medium {
    background: var(--color-warning);
  }

  .password-strength__fill.strong {
    background: var(--color-brand);
  }

  /* Label text pairs: error-ink, warning-ink and text green all pass 4.5:1
     on white (the warning fill itself is icon-only). */
  .password-strength__label {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-gray-600);
  }

  .password-strength__label:empty {
    display: none;
  }

  .password-strength__label.weak {
    color: var(--color-error-ink);
  }

  .password-strength__label.medium {
    color: var(--color-warning-ink);
  }

  .password-strength__label.strong {
    color: var(--color-primary);
  }

  :global(body.high-contrast) .password-strength__bar {
    outline: 2px solid var(--color-hc-ink);
  }

  :global(body.high-contrast) .password-strength__fill {
    background: var(--color-hc-ink);
  }

  :global(body.high-contrast) .password-strength__label {
    color: var(--color-hc-ink);
  }
</style>
