---
/**
 * Clickable chip that fills the login form with the demo credentials
 * (`[data-demo-fill]`, handled in src/scripts/pages/auth.js). Flat
 * lavender-soft pill with a lavender "Demo" tag (on-lavender text).
 */
interface Props {
  email?: string;
  password?: string;
}

const { email = "demo@minka.com", password = "demo1234" } = Astro.props;
---

<button type="button" class="demo-chip" data-demo-fill>
  <span class="demo-chip__tag">Demo</span>
  <span class="demo-chip__text">{email} · {password}</span>
</button>

<style>
  .demo-chip {
    align-self: center;
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    max-width: 100%;
    min-height: 44px;
    padding: var(--space-4) var(--space-16) var(--space-4) var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    background: var(--color-lavender-soft);
    color: var(--color-on-lavender);
    font-family: var(--font-primary);
    font-size: 0.85rem;
    font-weight: 700;
    line-height: 1.3;
    text-align: left;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  .demo-chip:hover {
    background: color-mix(in srgb, var(--color-lavender) 55%, var(--color-lavender-soft));
  }

  .demo-chip:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .demo-chip__tag {
    flex: none;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: var(--color-lavender);
    color: var(--color-on-lavender);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .demo-chip__text {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  :global(body.high-contrast) .demo-chip,
  :global(body.high-contrast) .demo-chip__tag {
    background: var(--color-hc-paper);
    color: var(--color-hc-ink);
    outline: 2px solid var(--color-hc-ink);
  }

  @media (forced-colors: active) {
    .demo-chip {
      border-color: ButtonText;
    }
  }
</style>
