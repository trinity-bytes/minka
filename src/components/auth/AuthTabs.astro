---
/**
 * Segmented tab control of the auth card. Each tab targets the form with
 * the same `data-form`; src/scripts/pages/auth.js toggles
 * `modal__tab--active` / aria-selected (class names kept for the script).
 */
export interface AuthTab {
  target: string;
  label: string;
  i18n: string;
}

interface Props {
  tabs: AuthTab[];
  active: string;
}

const { tabs, active } = Astro.props;
---

<div class="modal__tabs" role="tablist" aria-label="Selector de autenticación">
  {
    tabs.map((tab) => (
      <button
        class:list={["modal__tab", tab.target === active && "modal__tab--active"]}
        type="button"
        role="tab"
        aria-selected={tab.target === active ? "true" : "false"}
        data-tab-target={tab.target}
        id={`auth-tab-${tab.target}`}
        data-i18n={tab.i18n}
      >
        {tab.label}
      </button>
    ))
  }
</div>

<style>
  .modal__tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    background: var(--color-paper-2);
    border: var(--border-ink);
    padding: var(--space-4);
    border-radius: var(--radius-full);
  }

  .modal__tab {
    border: 2px solid transparent;
    background: transparent;
    padding: var(--space-8) var(--space-4);
    border-radius: var(--radius-full);
    font-weight: 600;
    font-size: 0.85rem;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--color-ink-2);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .modal__tab:hover {
    color: var(--color-ink);
    background: var(--color-card);
  }

  .modal__tab--active {
    background: var(--color-mint);
    border-color: var(--color-ink);
    color: var(--color-ink);
    font-weight: 700;
  }

  @media (min-width: 900px) {
    .modal__tab {
      font-size: 0.95rem;
      padding: var(--space-10) var(--space-8);
    }
  }
</style>
