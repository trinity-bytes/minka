---
/**
 * Pill tab control of the auth card (shared `.pill-tabs*` look from
 * app.css: active = ink pill, driven by aria-selected). Each tab targets
 * the form with the same `data-form`; src/scripts/pages/auth.js toggles
 * `modal__tab--active` / aria-selected (class names kept for the script).
 */
export interface AuthTab {
  target: string;
  label: string;
  i18n: string;
}

interface Props {
  tabs: AuthTab[];
  active: string;
}

const { tabs, active } = Astro.props;
---

<div class="pill-tabs modal__tabs" role="tablist" aria-label="Selector de autenticación">
  {
    tabs.map((tab) => (
      <button
        class:list={["pill-tabs__tab", "modal__tab", tab.target === active && "modal__tab--active"]}
        type="button"
        role="tab"
        aria-selected={tab.target === active ? "true" : "false"}
        data-tab-target={tab.target}
        id={`auth-tab-${tab.target}`}
        data-i18n={tab.i18n}
      >
        {tab.label}
      </button>
    ))
  }
</div>

<style>
  /* Full-width track tinted so it reads inside the white card. */
  .modal__tabs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    background: var(--color-paper);
  }

  .modal__tab {
    min-width: 0;
    padding-inline: var(--space-8);
    font-size: 0.88rem;
    white-space: nowrap;
  }

  @media (min-width: 900px) {
    .modal__tab {
      font-size: 0.95rem;
    }
  }
</style>
