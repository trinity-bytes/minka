---
/**
 * Simulated social login buttons (Google / Facebook) under a short "o"
 * divider (T10c-4: they sit below the primary submit as the secondary
 * route). Buttons carry `data-social-provider`; the click is handled in
 * src/scripts/pages/auth.js (simulateSocialLogin). Side by side when the
 * form panel is wide enough (container query on .auth-forms).
 */
interface Props {
  mode: "login" | "register";
}

const { mode } = Astro.props;

const COPY = {
  login: {
    google: { key: "auth_social_google", label: "Continuar con Google" },
    facebook: { key: "auth_social_facebook", label: "Continuar con Facebook" },
  },
  register: {
    google: { key: "auth_social_google_reg", label: "Registrarse con Google" },
    facebook: { key: "auth_social_facebook_reg", label: "Registrarse con Facebook" },
  },
} as const;

const copy = COPY[mode];
---

<div class="auth-divider" aria-hidden="true"><span data-i18n="auth_divider_or">o</span></div>
<div class="social-login">
  <button type="button" class="btn-social btn-google" data-social-provider="Google">
    <i class="fab fa-google"></i>
    <span data-i18n={copy.google.key}>{copy.google.label}</span>
  </button>
  <button type="button" class="btn-social btn-facebook" data-social-provider="Facebook">
    <i class="fab fa-facebook-f"></i>
    <span data-i18n={copy.facebook.key}>{copy.facebook.label}</span>
  </button>
</div>

<style>
  /* Flat pill buttons (visual-language T10b-2): Google white with a
     hairline, Facebook brand blue (white text 4.6:1). */
  .social-login {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  @container auth-forms (min-width: 430px) {
    .social-login {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .btn-social {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-10);
    width: 100%;
    min-height: 48px;
    padding: var(--space-8) var(--space-12);
    border: 1px solid var(--color-gray-200);
    border-radius: var(--radius-full);
    font-family: var(--font-primary);
    font-weight: 700;
    font-size: 0.9rem;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  .btn-social:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .btn-google {
    background-color: var(--color-card);
    color: var(--color-ink);
  }

  .btn-google:hover {
    background-color: var(--color-paper);
  }

  .btn-facebook {
    border-color: transparent;
    background-color: var(--color-brand-facebook);
    color: #ffffff;
  }

  .btn-facebook:hover {
    background-color: color-mix(in srgb, var(--color-brand-facebook) 86%, #000000);
  }

  .auth-divider {
    display: flex;
    align-items: center;
    margin: 0;
    color: var(--color-ink-2);
    font-size: 0.85rem;
    text-align: center;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: "";
    flex: 1;
    border-bottom: 1px solid var(--color-gray-200);
  }

  .auth-divider span {
    padding: 0 var(--space-16);
  }

  :global(body.high-contrast) .btn-social {
    background: var(--color-hc-paper);
    color: var(--color-hc-ink);
    border: 2px solid var(--color-hc-ink);
  }

  @media (forced-colors: active) {
    .btn-social {
      border-color: ButtonText;
    }
  }
</style>
