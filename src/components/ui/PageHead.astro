---
/**
 * Shared app page title (visual-language T10a): optional eyebrow pill, the
 * page h1 in the Fraunces title voice (the only serif on app pages), an
 * optional visible subtitle in ink-2 and an optional `actions` slot that
 * sits beside the text on wide screens and wraps below it on narrow ones.
 *
 * Backward compatible with the original compact head: `hint` still renders
 * an "i" button that reveals the page description on demand (port of
 * .page-head + the data-info-toggle behavior in components.js), so pages
 * that pass only `title`/`hint` keep working unchanged.
 */
interface Props {
  title: string;
  /** Description revealed on demand by the "i" button. */
  hint?: string;
  /** Always-visible description under the title. */
  subtitle?: string;
  /** Short label above the title. */
  eyebrow?: string;
  /** i18n key for the title (legacy I18n runtime). */
  titleKey?: string;
  /** i18n key for the hint (legacy I18n runtime). */
  hintKey?: string;
  /** i18n key for the subtitle (legacy I18n runtime). */
  subtitleKey?: string;
  /** i18n key for the eyebrow (legacy I18n runtime). */
  eyebrowKey?: string;
  /** id for the h1 (page scripts that rewrite the title). */
  titleId?: string;
  hintId?: string;
  class?: string;
}

const {
  title,
  hint,
  subtitle,
  eyebrow,
  titleKey,
  hintKey,
  subtitleKey,
  eyebrowKey,
  titleId,
  hintId = "page-info",
  class: className,
} = Astro.props;
const hasActions = Astro.slots.has("actions");
---

<div class:list={["container", "page-head", hasActions && "page-head--actions", className]}>
  <div class="page-head__text">
    {
      eyebrow && (
        <p class="page-head__eyebrow" data-i18n={eyebrowKey}>
          {eyebrow}
        </p>
      )
    }
    <div class="page-head__title-row">
      <h1 class="page-head__title" id={titleId} data-i18n={titleKey}>{title}</h1>
      {
        hint && (
          <button
            type="button"
            class="page-head__info-btn"
            data-info-toggle
            aria-controls={hintId}
            aria-expanded="false"
            aria-label="Más información sobre esta página"
          >
            <i class="fas fa-info" aria-hidden="true" />
          </button>
        )
      }
    </div>
    {
      subtitle && (
        <p class="page-head__subtitle" data-i18n={subtitleKey}>
          {subtitle}
        </p>
      )
    }
    {
      hint && (
        <p class="page-head__hint" id={hintId} hidden data-i18n={hintKey}>
          {hint}
        </p>
      )
    }
  </div>
  {
    hasActions && (
      <div class="page-head__actions">
        <slot name="actions" />
      </div>
    )
  }
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".page-head [data-info-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = document.getElementById(btn.getAttribute("aria-controls") ?? "");
      if (!target) return;
      const show = target.hidden;
      target.hidden = !show;
      btn.setAttribute("aria-expanded", String(show));
    });
  });
</script>

<style>
  .page-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-16) var(--space-24);
    padding-top: var(--space-32);
    padding-bottom: var(--space-24);
  }

  .page-head__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-8);
    min-width: 0;
    flex: 1 1 22rem;
  }

  .page-head__eyebrow {
    margin: 0;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--color-mint);
    color: var(--color-ink);
    font-family: var(--font-primary);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .page-head__title-row {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    max-width: 100%;
  }

  /* Fraunces title voice: display weight with the text optical size, so
     the soft serif stays crisp at app-title sizes. */
  .page-head__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: var(--font-display-weight);
    font-variation-settings: var(--font-display-axes-text);
    font-size: clamp(1.75rem, 1.1rem + 1.8vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: var(--font-display-tracking);
    color: var(--color-ink);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .page-head__subtitle {
    margin: 0;
    max-width: 62ch;
    color: var(--color-ink-2);
    font-family: var(--font-primary);
    font-size: 1rem;
    line-height: 1.55;
  }

  .page-head__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .page-head__info-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border: 1px solid transparent;
    border-radius: var(--radius-full);
    background: var(--color-card);
    color: var(--color-ink);
    font-size: 0.8rem;
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }

  .page-head__info-btn:hover,
  .page-head__info-btn[aria-expanded="true"] {
    background: var(--color-mint);
  }

  .page-head__info-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .page-head__hint {
    margin: 0;
    max-width: 65ch;
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-md);
    background: var(--color-mint);
    color: var(--color-ink-2);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .page-head__hint[hidden] {
    display: none;
  }

  @media (max-width: 768px) {
    .page-head {
      padding-top: var(--space-24);
      padding-bottom: var(--space-16);
    }

    .page-head__actions {
      width: 100%;
    }
  }

  @media (pointer: coarse) {
    .page-head__info-btn {
      width: 44px;
      height: 44px;
    }
  }

  :global(body.high-contrast) .page-head__eyebrow,
  :global(body.high-contrast) .page-head__hint,
  :global(body.high-contrast) .page-head__info-btn {
    background: var(--color-hc-paper);
    color: var(--color-hc-ink);
    outline: 2px solid var(--color-hc-ink);
  }

  :global(body.high-contrast) .page-head__info-btn:focus-visible {
    outline-width: 3px;
    outline-offset: 2px;
  }

  @media (forced-colors: active) {
    .page-head__eyebrow,
    .page-head__hint,
    .page-head__info-btn {
      border: 1px solid CanvasText;
    }
  }
</style>
