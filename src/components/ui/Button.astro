---
/**
 * Landing pill button. Renders <a> when `href` is set, <button> otherwise.
 * No border, soft lift on hover. Variants: paper | primary | ink | outline
 * (hairline ring with primary text, for low-emphasis actions).
 */
import type { HTMLAttributes } from "astro/types";

type Variant = "paper" | "primary" | "ink" | "outline";

interface Props extends Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "type"> {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: Variant;
  size?: "sm" | "md" | "lg";
  loading?: boolean;
}

const {
  href,
  type = "button",
  variant = "paper",
  size = "md",
  loading = false,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  "btn",
  "btn--sticker",
  `btn--${variant}`,
  size !== "md" && `btn--${size}`,
  loading && "is-loading",
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} aria-busy={loading ? "true" : undefined} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .btn--sticker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-primary);
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
  }

  .btn--sticker :global(i) {
    margin-right: var(--space-8);
  }

  /* === Sticker (landing pill) ===
     Flat since T9: the hairline carried over from the editorial theme is
     retired (transparent border keeps the size and shows under forced
     colors); high contrast restores a 2px black outline below. */
  .btn--sticker {
    gap: var(--space-10);
    font-weight: 800;
    color: var(--color-ink);
    background: var(--color-card);
    border: 1px solid transparent;
    border-radius: var(--radius-btn);
    padding: 15px 28px;
    box-shadow: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }

  .btn--sticker:hover,
  .btn--sticker:focus-visible {
    /* paper variant inherits the global link hover color (legacy parity) */
    color: var(--color-primary);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lift);
  }

  .btn--sticker:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }

  .btn--sticker.btn--primary,
  .btn--sticker.btn--primary:hover,
  .btn--sticker.btn--primary:focus-visible {
    background: var(--color-brand);
    color: var(--color-on-brand);
  }

  .btn--sticker.btn--ink {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn--sticker.btn--ink:hover,
  .btn--sticker.btn--ink:focus-visible {
    background: var(--color-ink-deep);
    color: var(--color-paper);
  }

  .btn--sticker.btn--outline {
    background: transparent;
    color: var(--color-primary);
    border-color: var(--color-gray-400);
    font-weight: 500;
  }

  .btn--sticker.btn--outline:hover,
  .btn--sticker.btn--outline:focus-visible {
    background: var(--color-card);
  }

  .btn--sticker.btn--sm {
    padding: var(--space-10) var(--space-20);
    font-size: 0.92rem;
    border-radius: var(--radius-btn);
  }

  .btn--sticker.btn--lg {
    padding: 18px 34px;
    font-size: 1.1rem;
  }

  /* === Loading / disabled === */
  .btn--sticker:disabled,
  .btn--sticker.is-loading {
    opacity: 0.65;
    cursor: not-allowed;
    pointer-events: none;
  }

  .btn--sticker.is-loading {
    position: relative;
    color: transparent !important;
  }

  .btn--sticker.is-loading::after {
    content: "";
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2.5px solid color-mix(in srgb, var(--color-brand) 30%, transparent);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: btn-spin 0.7s linear infinite;
  }

  @keyframes btn-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .btn--sticker:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  :global(body.high-contrast) .btn--sticker {
    border: var(--border-ink);
  }

  @media (forced-colors: active) {
    .btn--sticker {
      border-color: ButtonText;
    }
  }
</style>
