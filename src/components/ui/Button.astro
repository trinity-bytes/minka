---
/**
 * Button / link-button. Renders <a> when `href` is set, <button> otherwise.
 *
 * appearance:
 *  - "sticker" (default): editorial look of the landing (ink border + hard
 *    offset shadow). Variants: paper | primary | ink.
 *  - "flat": legacy app look (.btn). Variants: primary | secondary | outline.
 */
import type { HTMLAttributes } from "astro/types";

type Variant = "paper" | "primary" | "ink" | "secondary" | "outline";

interface Props extends Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "type"> {
  href?: string;
  type?: "button" | "submit" | "reset";
  variant?: Variant;
  appearance?: "sticker" | "flat";
  size?: "sm" | "md" | "lg";
  loading?: boolean;
}

const {
  href,
  type = "button",
  variant = "paper",
  appearance = "sticker",
  size = "md",
  loading = false,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  "btn",
  `btn--${appearance}`,
  `btn--${variant}`,
  size !== "md" && `btn--${size}`,
  loading && "is-loading",
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} aria-busy={loading ? "true" : undefined} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-primary);
    font-size: 1rem;
    text-decoration: none;
    cursor: pointer;
  }

  .btn :global(i) {
    margin-right: var(--space-8);
  }

  /* === Sticker (editorial) === */
  .btn--sticker {
    gap: var(--space-10);
    font-weight: 800;
    color: var(--color-ink);
    background: var(--color-card);
    border: var(--border-ink);
    border-radius: var(--radius-btn);
    padding: 15px 28px;
    box-shadow: var(--shadow-hard-btn);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }

  .btn--sticker:hover,
  .btn--sticker:focus-visible {
    /* paper variant inherits the global link hover color (legacy parity) */
    color: var(--color-primary);
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-hard-btn-hover);
  }

  .btn--sticker:active {
    transform: translate(2px, 2px);
    box-shadow: var(--shadow-hard-xs);
  }

  .btn--sticker.btn--primary,
  .btn--sticker.btn--primary:hover,
  .btn--sticker.btn--primary:focus-visible {
    background: var(--color-primary-pop);
    color: var(--color-ink);
  }

  .btn--sticker.btn--ink {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn--sticker.btn--ink:hover,
  .btn--sticker.btn--ink:focus-visible {
    background: var(--color-ink-deep);
    color: var(--color-paper);
  }

  .btn--sticker.btn--sm {
    padding: var(--space-10) var(--space-20);
    font-size: 0.92rem;
    border-radius: var(--radius-md);
  }

  .btn--sticker.btn--lg {
    padding: 18px 34px;
    font-size: 1.1rem;
  }

  /* === Flat (app) === */
  .btn--flat {
    font-weight: 600;
    padding: var(--space-12) var(--space-24);
    border-radius: var(--radius-md);
    border: none;
    transition: all 0.2s ease;
  }

  .btn--flat:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .btn--flat.btn--primary {
    background: var(--color-primary-ink);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-md);
  }

  .btn--flat.btn--primary:hover {
    background: var(--color-primary-dark);
    color: var(--color-on-primary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .btn--flat.btn--primary:active {
    background: var(--color-primary-darker);
    color: var(--color-on-primary);
    transform: translateY(0);
  }

  .btn--flat.btn--secondary {
    background: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }

  .btn--flat.btn--secondary:hover {
    background: color-mix(in srgb, var(--color-primary-pop) 10%, transparent);
  }

  .btn--flat.btn--outline,
  .btn--flat.btn--paper {
    background: transparent;
    color: var(--color-gray-700);
    border: 1.5px solid var(--color-gray-300);
  }

  .btn--flat.btn--outline:hover,
  .btn--flat.btn--paper:hover {
    background: var(--color-gray-50);
    border-color: var(--color-gray-400);
    color: var(--color-gray-900);
  }

  .btn--flat.btn--ink {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .btn--flat.btn--sm {
    padding: var(--space-8) var(--space-16);
    font-size: 0.9rem;
  }

  .btn--flat.btn--lg {
    padding: var(--space-16) var(--space-32);
    font-size: 1.125rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .btn--flat:active {
      transform: scale(0.98);
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .btn--flat {
      min-height: 44px;
      min-width: 44px;
    }
  }

  /* === Loading / disabled === */
  .btn:disabled,
  .btn.is-loading {
    opacity: 0.65;
    cursor: not-allowed;
    pointer-events: none;
  }

  .btn.is-loading {
    position: relative;
    color: transparent !important;
  }

  .btn.is-loading::after {
    content: "";
    position: absolute;
    width: 18px;
    height: 18px;
    border: 2.5px solid color-mix(in srgb, var(--color-on-primary) 40%, transparent);
    border-top-color: var(--color-on-primary);
    border-radius: 50%;
    animation: btn-spin 0.7s linear infinite;
  }

  .btn--sticker.is-loading::after,
  .btn--secondary.is-loading::after,
  .btn--outline.is-loading::after {
    border-color: color-mix(in srgb, var(--color-primary-pop) 30%, transparent);
    border-top-color: var(--color-primary);
  }

  @keyframes btn-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
