---
/**
 * App card surface: white, --radius-card corners, flat (no border, no
 * offset shadow). `shadow` md/lg add a soft drop; `interactive` lifts softly.
 * Inner padding/layout belongs to the consumer.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  as?: "div" | "article" | "section" | "li" | "figure";
  tone?: "card" | "mint" | "accent-soft" | "paper";
  radius?: "lg" | "xl";
  shadow?: "sm" | "md" | "lg";
  /** Soft lift on hover (2px rise + shadow; no rise under reduced motion). */
  interactive?: boolean;
}

const {
  as: Tag = "div",
  tone = "card",
  radius = "lg",
  shadow = "sm",
  interactive = false,
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  class:list={[
    "card",
    `card--${tone}`,
    `card--radius-${radius}`,
    `card--shadow-${shadow}`,
    interactive && "card--interactive",
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>

<style>
  /* White app card on the tinted background (T9): no border, no offset
     shadow. The transparent border keeps the box size and becomes visible
     under forced colors; high contrast restores a 2px black outline through
     the global `body.high-contrast .card` rule in global.css. Tinted tones
     that would vanish on the tinted page keep a hairline. */
  .card {
    position: relative;
    margin: 0;
    background: var(--color-card);
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    box-shadow: none;
  }

  .card--mint {
    background: var(--color-mint);
  }

  .card--accent-soft {
    background: var(--color-accent-soft);
  }

  .card--paper {
    background: var(--color-paper);
    border-color: var(--color-border);
  }

  .card--radius-xl {
    border-radius: var(--radius-xl);
  }

  .card--shadow-md {
    box-shadow: var(--shadow-sm);
  }

  .card--shadow-lg {
    box-shadow: var(--shadow-lg);
  }

  .card--interactive {
    transition:
      transform var(--dur-fast) var(--ease-standard),
      box-shadow var(--dur-fast) var(--ease-standard);
  }

  .card--interactive:hover {
    box-shadow: var(--shadow-lift);
  }

  @media (prefers-reduced-motion: no-preference) {
    .card--interactive:hover {
      transform: translateY(-2px) rotate(var(--card-hover-rotate, 0deg));
    }
  }

  @media (forced-colors: active) {
    .card {
      border-color: CanvasText;
    }
  }
</style>
