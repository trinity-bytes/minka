---
/**
 * Small pill for filters and tags. Renders <a> with `href`, <button> when
 * `interactive`, otherwise a <span>.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  href?: string;
  interactive?: boolean;
  tone?: "mint" | "clear";
  selected?: boolean;
}

const { href, interactive = false, tone = "mint", selected = false, class: className, ...rest } =
  Astro.props;
const classes = ["chip", `chip--${tone}`, selected && "is-selected", className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : interactive ? (
    <button type="button" class:list={classes} aria-pressed={selected ? "true" : "false"} {...rest}>
      <slot />
    </button>
  ) : (
    <span class:list={classes} {...rest}>
      <slot />
    </span>
  )
}

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-12);
    border-radius: var(--radius-full);
    border: var(--border-ink-thin);
    background: var(--color-mint);
    color: var(--color-ink);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    transition: background 0.15s ease;
  }

  a.chip,
  button.chip {
    cursor: pointer;
  }

  a.chip:hover,
  button.chip:hover,
  .chip.is-selected {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .chip--clear {
    border-color: var(--color-gray-300);
    background: transparent;
    color: var(--color-ink-2);
  }

  a.chip--clear:hover,
  button.chip--clear:hover {
    background: var(--color-paper-2);
    color: var(--color-ink);
  }
</style>
