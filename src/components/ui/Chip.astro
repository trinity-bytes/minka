---
/**
 * Small pill for filters and tags. Renders <a> with `href`, <button> when
 * `interactive`, otherwise a <span>.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"span"> {
  href?: string;
  interactive?: boolean;
  tone?: "mint" | "clear";
  selected?: boolean;
}

const { href, interactive = false, tone = "mint", selected = false, class: className, ...rest } =
  Astro.props;
const classes = ["chip", `chip--${tone}`, selected && "is-selected", className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : interactive ? (
    <button type="button" class:list={classes} aria-pressed={selected ? "true" : "false"} {...rest}>
      <slot />
    </button>
  ) : (
    <span class:list={classes} {...rest}>
      <slot />
    </span>
  )
}

<style>
  /* Flat pills (T9): mint fill without the editorial hairline; the current
     or selected chip is the dark ink pill, as in the app shell. */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-12);
    border-radius: var(--radius-chip);
    border: 1px solid transparent;
    background: var(--color-mint);
    color: var(--color-ink);
    font-family: var(--font-primary);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  a.chip,
  button.chip {
    min-height: 36px;
    padding-inline: var(--space-16);
    cursor: pointer;
  }

  a.chip:hover,
  button.chip:hover {
    background: color-mix(in srgb, var(--color-mint) 70%, var(--color-brand));
    color: var(--color-ink);
  }

  .chip.is-selected,
  a.chip.is-selected:hover,
  button.chip.is-selected:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  a.chip:focus-visible,
  button.chip:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .chip--clear {
    border-color: var(--color-gray-200);
    background: var(--color-card);
    color: var(--color-ink-2);
  }

  a.chip--clear:hover,
  button.chip--clear:hover {
    background: var(--color-paper-2);
    color: var(--color-ink);
  }

  @media (hover: none) and (pointer: coarse) {
    a.chip,
    button.chip {
      min-height: 44px;
    }
  }

  :global(body.high-contrast) .chip {
    border: var(--border-ink);
  }

  :global(body.high-contrast) .chip.is-selected {
    background: var(--color-hc-ink);
    color: var(--color-hc-paper);
  }

  @media (forced-colors: active) {
    .chip.is-selected {
      outline: 2px solid Highlight;
    }
  }
</style>
