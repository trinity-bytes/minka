---
/**
 * Flat, tilted pill label (solid fill, no border or shadow). Consumers can
 * position it with their own class and change the tilt through
 * `--sticker-rotate`. Legacy tones map onto the new palette:
 * green -> mint, amber -> lavender, terra -> lavender-soft (renamed in T13).
 */
import type { HTMLAttributes } from "astro/types";

type Tone = "paper" | "mint" | "brand" | "lavender" | "lavender-soft" | "ink";
type LegacyTone = "green" | "amber" | "terra";

interface Props extends HTMLAttributes<"span"> {
  tone?: Tone | LegacyTone;
  /** Handwritten (Pacifico) variant; legacy, dropped with Pacifico in T13. */
  hand?: boolean;
  as?: "span" | "p" | "div";
}

const LEGACY: Record<LegacyTone, Tone> = { green: "mint", amber: "lavender", terra: "lavender-soft" };

const { tone = "paper", hand = false, as: Tag = "span", class: className, ...rest } = Astro.props;
const resolved = tone in LEGACY ? LEGACY[tone as LegacyTone] : (tone as Tone);
---

<Tag class:list={["sticker", `sticker--${resolved}`, hand && "sticker--hand", className]} {...rest}>
  <slot />
</Tag>

<style>
  .sticker {
    display: inline-block;
    font-family: var(--font-primary);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sticker-fg, var(--color-ink));
    background: var(--sticker-bg, var(--color-card));
    border-radius: var(--radius-full);
    padding: 8px 16px;
    transform: rotate(var(--sticker-rotate, -2deg));
    white-space: nowrap;
    margin: 0;
  }

  .sticker--mint {
    --sticker-bg: var(--color-mint);
  }

  .sticker--brand {
    --sticker-bg: var(--color-brand);
  }

  .sticker--lavender {
    --sticker-bg: var(--color-lavender);
    --sticker-fg: var(--color-on-lavender);
  }

  .sticker--lavender-soft {
    --sticker-bg: var(--color-lavender-soft);
    --sticker-fg: var(--color-on-lavender);
  }

  .sticker--ink {
    --sticker-bg: var(--color-ink);
    --sticker-fg: var(--color-brand);
  }

  .sticker--hand {
    font-family: var(--font-accent);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-size: 1rem;
  }

  /* Without the old ink border, high contrast needs an explicit outline. */
  :global(body.high-contrast) .sticker {
    outline: 2px solid var(--color-hc-ink);
  }
</style>
