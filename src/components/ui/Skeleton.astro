---
/**
 * Loading placeholders (T11): an sr-only status label plus `count`
 * aria-hidden shimmer blocks (card = media + two lines, row = avatar
 * circle + two lines, tile = square media). Place it inside the region a
 * script fills after load and give that region aria-busy="true"; the
 * script replaces the placeholders and clears aria-busy. Markup comes from
 * renderSkeleton (src/scripts/lib/states.js); `tag="li"` inside lists.
 * Shimmer runs only under prefers-reduced-motion: no-preference.
 */
import { renderSkeleton } from "../../scripts/lib/states.js";

interface Props {
  variant?: "card" | "row" | "tile";
  count?: number;
  label?: string;
  tag?: "div" | "li";
}

const html = renderSkeleton(Astro.props);
---

<Fragment set:html={html} />
