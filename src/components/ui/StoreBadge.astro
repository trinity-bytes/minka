---
/**
 * "Disponible en Google Play" pill with the official Google Play icon (its
 * four Google brand colors stay as drawn). Dark = ink pill for light
 * surfaces; light = white pill with a hairline for dark surfaces.
 * Renders a link when `href` is set, a static label otherwise. Links are
 * magnetic: they lean toward a fine pointer hovering them and spring back.
 */
import type { HTMLAttributes } from "astro/types";
import GooglePlayIcon from "../../assets/brand/google-play-icon.svg";

interface Props extends HTMLAttributes<"a"> {
  theme?: "dark" | "light";
  href?: string;
}

const { theme = "dark", href, class: className, ...rest } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag
  href={href}
  class:list={["store-badge", `store-badge--${theme}`, className]}
  data-magnetic={href ? "" : undefined}
  {...rest}
>
  <GooglePlayIcon class="store-badge__icon" aria-hidden="true" />
  <span class="store-badge__text">
    <span class="store-badge__overline">Disponible en</span>
    <span class="store-badge__name">Google Play</span>
  </span>
</Tag>

<script>
  import { magneticPull } from "../../scripts/lib/pointer.js";

  // Magnetic pull through --magnet-x/--magnet-y; leaving the badge clears
  // them and the spring transition brings it home. Fine pointers only.
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (finePointer && !reduceMotion) {
    document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((badge) => {
      badge.addEventListener("pointermove", (event) => {
        if (event.pointerType === "touch") return;
        // The badge's resting box: its rect minus the (possibly mid-transition) pull.
        const box = badge.getBoundingClientRect();
        const [shiftX = 0, shiftY = 0] = getComputedStyle(badge)
          .translate.split(" ")
          .map((value) => parseFloat(value) || 0);
        const pull = magneticPull(
          { left: box.left - shiftX, top: box.top - shiftY, width: box.width, height: box.height },
          event.clientX,
          event.clientY,
          0.35,
          14,
        );
        badge.classList.add("is-pulled");
        badge.style.setProperty("--magnet-x", `${pull.x.toFixed(2)}px`);
        badge.style.setProperty("--magnet-y", `${pull.y.toFixed(2)}px`);
      });
      badge.addEventListener("pointerleave", () => {
        badge.classList.remove("is-pulled");
        badge.style.removeProperty("--magnet-x");
        badge.style.removeProperty("--magnet-y");
      });
    });
  }
</script>

<style>
  .store-badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 10px 26px 10px 18px;
    border-radius: var(--radius-full);
    line-height: 1.2;
    white-space: nowrap;
    text-decoration: none;
    translate: var(--magnet-x, 0px) var(--magnet-y, 0px);
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      translate var(--dur-slow) var(--ease-spring);
  }

  /* Follow the pointer closely while pulled; the spring only plays on release. */
  .store-badge.is-pulled {
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      translate var(--dur-fast) var(--ease-out);
  }

  .store-badge--dark {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .store-badge--light {
    background: var(--color-card);
    color: var(--color-ink);
    border: 1px solid var(--color-border);
  }

  a.store-badge:hover,
  a.store-badge:focus-visible {
    transform: translate(-2px, -2px);
    box-shadow: var(--shadow-lift);
  }

  a.store-badge:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .store-badge :global(.store-badge__icon) {
    flex: none;
    width: 25.4px;
    height: 28px;
  }

  .store-badge__text {
    display: grid;
  }

  .store-badge__overline {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .store-badge--light .store-badge__overline {
    color: var(--color-ink-2);
  }

  .store-badge__name {
    font-size: 1.125rem;
    font-weight: 700;
  }

  @media (forced-colors: active) {
    .store-badge {
      border: 1px solid ButtonText;
    }
  }
</style>
