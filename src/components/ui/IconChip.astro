---
/**
 * Circular icon chip (branding-board style): filled tones or an outlined
 * ring. Pass `icon` for the inline Icon set, or slot any glyph (Font Awesome
 * `<i>`, Logomark, ...). Decorative unless `label` is given.
 */
import type { HTMLAttributes } from "astro/types";
import Icon, { type IconName } from "./Icon.astro";

interface Props extends HTMLAttributes<"span"> {
  icon?: IconName;
  tone?: "brand" | "lavender" | "ink" | "mint";
  variant?: "filled" | "outlined";
  size?: "sm" | "md" | "lg";
  label?: string;
}

const {
  icon,
  tone = "brand",
  variant = "filled",
  size = "md",
  label,
  class: className,
  ...rest
} = Astro.props;
const a11y = label ? { role: "img" as const, "aria-label": label } : { "aria-hidden": "true" as const };
---

<span
  class:list={["icon-chip", `icon-chip--${tone}`, `icon-chip--${variant}`, `icon-chip--${size}`, className]}
  {...a11y}
  {...rest}
>
  {icon ? <Icon name={icon} class="icon-chip__icon" /> : <slot />}
</span>

<style>
  .icon-chip {
    --chip-size: 48px;
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--chip-size);
    height: var(--chip-size);
    border-radius: var(--radius-full);
    font-size: calc(var(--chip-size) * 0.42);
    line-height: 1;
    background: var(--chip-bg);
    color: var(--chip-fg);
    border: 2.5px solid var(--chip-ring, transparent);
  }

  .icon-chip--sm {
    --chip-size: 36px;
  }
  .icon-chip--lg {
    --chip-size: 64px;
  }

  .icon-chip :global(svg),
  .icon-chip__icon {
    width: 1em;
    height: 1em;
  }

  /* Filled tones: text-safe pairs from tokens.css. */
  .icon-chip--brand {
    --chip-bg: var(--color-brand);
    --chip-fg: var(--color-ink);
  }
  .icon-chip--lavender {
    --chip-bg: var(--color-lavender);
    --chip-fg: var(--color-on-lavender);
  }
  .icon-chip--ink {
    --chip-bg: var(--color-ink);
    --chip-fg: var(--color-brand);
  }
  .icon-chip--mint {
    --chip-bg: var(--color-mint);
    --chip-fg: var(--color-ink);
  }

  /* Outlined: transparent fill, ring and glyph in the tone's strong color. */
  .icon-chip--outlined {
    --chip-bg: transparent;
    --chip-ring: currentColor;
  }
  .icon-chip--outlined.icon-chip--brand {
    --chip-fg: var(--color-primary);
  }
  .icon-chip--outlined.icon-chip--lavender {
    --chip-fg: var(--color-lavender-ink);
  }
  .icon-chip--outlined.icon-chip--ink,
  .icon-chip--outlined.icon-chip--mint {
    --chip-fg: var(--color-ink);
  }

  @media (forced-colors: active) {
    .icon-chip {
      border-color: CanvasText;
    }
  }
</style>
