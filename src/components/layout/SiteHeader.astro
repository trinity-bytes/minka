---
/**
 * Landing header: a flat bar aligned to the hero grid with the logotype,
 * numbered anchor links (01-06) and the download CTA. At the top of the page
 * it has no background or border; past ~80px of scroll it stays pinned edge
 * to edge on the page background with a 1px bottom line (200ms ease-out
 * fade, no pill, no shadow). Below 860px the links open as a full-screen
 * menu driven by menu-disclosure (focus trap, Escape, focus return) with the
 * Google Play badge at the bottom, while the CTA stays visible ("Instalar"
 * on phones). The 404 page passes `anchorBase={url()}` so the anchors (CTA
 * included) point back to the landing.
 */
import Button from "../ui/Button.astro";
import StoreBadge from "../ui/StoreBadge.astro";
import Logotype from "../brand/Logotype.astro";
import { INSTALL_HREF } from "../../lib/store";

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links?: NavLink[];
  ctaHref?: string;
  ctaLabel?: string;
  /** Shorter CTA label for phones (<= 480px). */
  ctaShortLabel?: string;
  /** Logo target; defaults to the hero anchor. */
  homeHref?: string;
  /** Prefix for `#anchor` links when rendered outside the landing. */
  anchorBase?: string;
  /** Show the landing page's scroll progress above the header. */
  showProgress?: boolean;
}

const {
  links = [
    { href: "#como-funciona", label: "Cómo funciona" },
    { href: "#beneficios", label: "Beneficios" },
    { href: "#plataforma", label: "La app" },
    { href: "#conoce-mas", label: "Video" },
    { href: "#impacto", label: "Impacto" },
    { href: "#testimonios", label: "Testimonios" },
  ],
  ctaHref = "#descargar",
  ctaLabel = "Descargar la app",
  ctaShortLabel = "Instalar",
  anchorBase = "",
  showProgress = false,
} = Astro.props;
const withBase = (href: string) => (href.startsWith("#") ? `${anchorBase}${href}` : href);
const homeHref = withBase(Astro.props.homeHref ?? "#inicio");
const navLinks = links.map((link) => ({ ...link, href: withBase(link.href) }));
const cta = withBase(ctaHref);
const installHref = withBase(INSTALL_HREF);
const folio = (index: number) => String(index + 1).padStart(2, "0");
---

<header class="site-header" data-site-header>
  {showProgress && <div class="site-header__progress" data-scroll-progress aria-hidden="true"></div>}
  <div class="site-header__inner">
    <a href={homeHref} class="site-header__logo" aria-label="Mink'a, inicio">
      <Logotype tone="ink" size={32} decorative />
    </a>
    <nav class="site-nav" id="menu-principal" aria-label="Navegación principal">
      <ul class="site-nav__list">
        {
          navLinks.map((link, index) => (
            <li>
              <a href={link.href} class="site-nav__link">
                <span class="site-nav__num" aria-hidden="true">
                  {folio(index)}
                </span>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__install">
        <StoreBadge href={installHref} />
        <p class="site-nav__note">Gratis · Android 8.0 o superior</p>
      </div>
    </nav>
    <div class="site-header__actions">
      <Button href={cta} variant="primary" size="sm" class="site-header__cta">
        <span class="site-header__cta-long">{ctaLabel}</span>
        <span class="site-header__cta-short">{ctaShortLabel}</span>
      </Button>
      <button
        type="button"
        class="site-nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-principal"
      >
        <span class="site-nav-toggle__bar" aria-hidden="true"></span>
        <span class="site-nav-toggle__bar" aria-hidden="true"></span>
        <span class="site-nav-toggle__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { createMenu } from "../../scripts/menu-disclosure";
  import { scrollProgress } from "../../scripts/lib/scroll-progress.js";

  /** Scroll distance after which the bar gets its background and line. */
  const PIN_AFTER = 80;

  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > PIN_AFTER);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const progress = header.querySelector<HTMLElement>("[data-scroll-progress]");
    if (progress) {
      let frame = 0;
      const updateProgress = () => {
        frame = 0;
        const root = document.documentElement;
        progress.style.transform = `scaleX(${scrollProgress(window.scrollY, root.scrollHeight, root.clientHeight)})`;
      };
      const scheduleProgress = () => {
        if (!frame) frame = window.requestAnimationFrame(updateProgress);
      };
      updateProgress();
      window.addEventListener("scroll", scheduleProgress, { passive: true });
      window.addEventListener("resize", scheduleProgress);
    }

    const toggle = header.querySelector<HTMLButtonElement>(".site-nav-toggle");
    const nav = header.querySelector<HTMLElement>(".site-nav");
    if (toggle && nav) {
      const menu = createMenu({
        toggle,
        panel: nav,
        onChange: (open) => {
          toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
          nav.classList.toggle("is-open", open);
          header.classList.toggle("is-menu-open", open);
          // The full-screen menu owns the viewport: freeze the page behind it.
          document.documentElement.style.overflow = open ? "hidden" : "";
        },
      });
      nav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => menu.setOpen(false));
      });
      // Crossing into the desktop layout hides the toggle: reset the menu.
      window.matchMedia("(min-width: 861px)").addEventListener("change", (e) => {
        if (e.matches && menu.isOpen()) menu.setOpen(false);
      });
    }
  }
</script>

<style>
  .site-header {
    --header-h: 80px;
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    background-color: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background-color 200ms ease-out,
      border-color 200ms ease-out;
  }

  .site-header.is-scrolled,
  .site-header.is-menu-open {
    background-color: var(--color-bg);
    border-bottom-color: var(--color-border);
  }

  .site-header__progress {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 5px;
    background: linear-gradient(90deg, var(--color-brand) 0 72%, var(--color-lavender) 72% 90%, var(--color-lavender-ink) 90%);
    box-shadow: 0 1px 0 var(--color-ink);
    pointer-events: none;
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* Same box as .hero__grid so the logo and CTA line up with the hero. */
  .site-header__inner {
    position: relative;
    max-width: 1320px;
    height: var(--header-h);
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    /* Optical centering: the wordmark box reserves ascender/leaf space above the
       x-height, so its visual mass sits low. Lift it slightly. */
    translate: 0 -3px;
    border-radius: var(--radius-sm, 8px);
  }

  /* === Numbered links === */
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 28px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__link {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 8px 0;
    font-size: 0.93rem;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: none;
    text-underline-offset: 6px;
    text-decoration-thickness: 2px;
  }

  .site-nav__num {
    font-family: var(--font-display);
    font-weight: var(--font-title-weight);
    font-variation-settings: var(--font-display-axes-text);
    font-size: 0.93rem;
    color: var(--color-primary);
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible {
    text-decoration-line: underline;
    text-decoration-color: var(--color-brand);
  }

  .site-nav__install {
    display: none;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .site-header__inner :global(.btn.site-header__cta) {
    border-color: transparent;
    padding: 10px 20px;
  }

  /* === Hamburger: three bars that morph into an X === */
  .site-nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-ink);
    color: var(--color-card);
    cursor: pointer;
  }

  .site-nav-toggle__bar {
    position: absolute;
    left: 15px;
    width: 14px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      translate var(--dur-base) var(--ease-out),
      rotate var(--dur-base) var(--ease-out),
      opacity var(--dur-fast) var(--ease-standard);
  }

  .site-nav-toggle__bar:nth-child(1) {
    top: 16px;
  }

  .site-nav-toggle__bar:nth-child(2) {
    top: 21px;
  }

  .site-nav-toggle__bar:nth-child(3) {
    top: 26px;
  }

  .site-nav-toggle[aria-expanded="true"] .site-nav-toggle__bar:nth-child(1) {
    translate: 0 5px;
    rotate: 45deg;
  }

  .site-nav-toggle[aria-expanded="true"] .site-nav-toggle__bar:nth-child(2) {
    opacity: 0;
  }

  .site-nav-toggle[aria-expanded="true"] .site-nav-toggle__bar:nth-child(3) {
    translate: 0 -5px;
    rotate: -45deg;
  }

  .site-nav-toggle:focus-visible {
    outline: 3px solid var(--color-brand);
    outline-offset: 2px;
  }

  @media (max-width: 1080px) {
    .site-header__inner {
      padding: 0 24px;
    }

    .site-nav__list {
      gap: 14px;
    }

    .site-nav__link {
      font-size: 0.86rem;
    }
  }

  /* === Phone/tablet: full-screen menu under the bar === */
  @media (max-width: 860px) {
    .site-header {
      --header-h: 68px;
    }

    .site-header__inner {
      padding: 0 16px;
    }

    .site-nav {
      display: none;
      position: fixed;
      inset: var(--header-h) 0 0 0;
      flex-direction: column;
      justify-content: space-between;
      gap: 32px;
      padding: 24px 24px max(32px, env(safe-area-inset-bottom));
      background: var(--color-bg);
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .site-nav__link {
      display: flex;
      align-items: baseline;
      gap: 14px;
      padding: 14px 0;
      border-bottom: 1px solid var(--color-border);
      font-family: var(--font-display);
      font-weight: var(--font-display-weight);
      font-variation-settings: var(--font-display-axes);
      font-size: clamp(1.9rem, 8.5vw, 2.4rem);
      line-height: 1.1;
      letter-spacing: var(--font-display-tracking);
    }

    .site-nav__num {
      min-width: 2ch;
      font-weight: inherit;
      font-variation-settings: inherit;
      font-size: inherit;
    }

    .site-nav__install {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .site-nav__note {
      margin: 0;
      font-size: 0.9rem;
      color: var(--color-ink-2);
    }

    .site-nav-toggle {
      display: inline-block;
    }
  }

  .site-header__cta-short {
    display: none;
  }

  @media (max-width: 480px) {
    .site-header__cta-long {
      display: none;
    }

    .site-header__cta-short {
      display: inline;
    }
  }
</style>
