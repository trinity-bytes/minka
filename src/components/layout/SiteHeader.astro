---
/**
 * Landing header: floating white pill (detached from the top edge) with the
 * logotype, pill anchor links and pill CTAs; it gains a soft shadow once the
 * page scrolls. Below 860px the links move into a dropdown panel driven by
 * menu-disclosure (focus trap, Escape, focus return). Other public pages
 * (about, 404) pass `anchorBase={url()}` so the anchors point back to the
 * landing.
 */
import Button from "../ui/Button.astro";
import Logotype from "../brand/Logotype.astro";
import { url } from "../../lib/url";

interface NavLink {
  href: string;
  label: string;
}

interface Props {
  links?: NavLink[];
  ctaHref?: string;
  ctaLabel?: string;
  /** Secondary pill (sign in); pass an empty label to hide it. */
  loginHref?: string;
  loginLabel?: string;
  /** Logo target; defaults to the hero anchor. */
  homeHref?: string;
  /** Prefix for `#anchor` links when rendered outside the landing. */
  anchorBase?: string;
}

const {
  links = [
    { href: "#como-funciona", label: "Cómo funciona" },
    { href: "#beneficios", label: "Beneficios" },
    { href: "#impacto", label: "Impacto" },
    { href: "#testimonios", label: "Testimonios" },
  ],
  ctaHref = url("pages/auth.html"),
  ctaLabel = "Empezar ahora",
  loginHref = url("pages/auth.html"),
  loginLabel = "Ingresar",
  anchorBase = "",
} = Astro.props;
const withBase = (href: string) => (href.startsWith("#") ? `${anchorBase}${href}` : href);
const homeHref = withBase(Astro.props.homeHref ?? "#inicio");
const navLinks = links.map((link) => ({ ...link, href: withBase(link.href) }));
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <a href={homeHref} class="site-header__logo" aria-label="Mink'a, inicio">
      <Logotype tone="ink" size={32} decorative />
    </a>
    <nav class="site-nav" id="menu-principal" aria-label="Navegación principal">
      {navLinks.map((link) => <a href={link.href} class="site-nav__link">{link.label}</a>)}
      <!-- Mobile-only actions (inside the dropdown); desktop ones live in actions. -->
      <div class="site-nav__actions">
        {loginLabel && <a href={loginHref} class="site-header__login">{loginLabel}</a>}
        <Button href={ctaHref} variant="primary" size="sm" class="site-header__cta">
          {ctaLabel}
        </Button>
      </div>
    </nav>
    <div class="site-header__actions">
      {loginLabel && <a href={loginHref} class="site-header__login">{loginLabel}</a>}
      <Button href={ctaHref} variant="primary" size="sm" class="site-header__cta">
        {ctaLabel}
      </Button>
      <button
        type="button"
        class="site-nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="menu-principal"
      >
        <span class="site-nav-toggle__bar" aria-hidden="true"></span>
        <span class="site-nav-toggle__bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<script>
  import { createMenu } from "../../scripts/menu-disclosure";

  const header = document.querySelector<HTMLElement>("[data-site-header]");
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 40);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });

    const toggle = header.querySelector<HTMLButtonElement>(".site-nav-toggle");
    const nav = header.querySelector<HTMLElement>(".site-nav");
    if (toggle && nav) {
      const menu = createMenu({
        toggle,
        panel: nav,
        onChange: (open) => {
          toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
          nav.classList.toggle("is-open", open);
        },
      });
      nav.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => menu.setOpen(false));
      });
      // Crossing into the desktop layout hides the toggle: reset the menu.
      window.matchMedia("(min-width: 861px)").addEventListener("change", (e) => {
        if (e.matches && menu.isOpen()) menu.setOpen(false);
      });
    }
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    padding: 14px 24px 0;
    pointer-events: none;
  }

  .site-header__inner {
    position: relative;
    pointer-events: auto;
    max-width: 1240px;
    margin: 0 auto;
    padding: 8px 8px 8px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    background: color-mix(in srgb, var(--color-card) 86%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid color-mix(in srgb, var(--color-ink) 8%, transparent);
    border-radius: var(--radius-full);
    transition:
      background-color var(--dur-base) var(--ease-standard),
      box-shadow var(--dur-base) var(--ease-standard);
  }

  .site-header.is-scrolled .site-header__inner {
    background: color-mix(in srgb, var(--color-card) 96%, transparent);
    box-shadow: var(--shadow-lift);
  }

  .site-header__logo {
    display: flex;
    align-items: center;
    border-radius: var(--radius-sm, 8px);
  }

  /* === Pill links === */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .site-nav__link,
  .site-header__login {
    display: inline-flex;
    align-items: center;
    padding: 10px 16px;
    border-radius: var(--radius-full);
    font-size: 0.93rem;
    font-weight: 600;
    color: var(--color-ink-2);
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .site-nav__link:hover,
  .site-nav__link:focus-visible,
  .site-header__login:hover,
  .site-header__login:focus-visible {
    background: var(--color-mint);
    color: var(--color-ink);
  }

  .site-header__login {
    font-weight: 700;
    color: var(--color-ink);
    box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--color-ink) 16%, transparent);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .site-header__inner :global(.btn.site-header__cta) {
    border-color: transparent;
    padding: 10px 20px;
  }

  /* Mobile dropdown actions are hidden on desktop. */
  .site-nav__actions {
    display: none;
  }

  /* === Hamburger: two bars that morph into an X === */
  .site-nav-toggle {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-full);
    background: var(--color-ink);
    color: var(--color-card);
    cursor: pointer;
  }

  .site-nav-toggle__bar {
    position: absolute;
    left: 13px;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition:
      translate var(--dur-base) var(--ease-out),
      rotate var(--dur-base) var(--ease-out);
  }

  .site-nav-toggle__bar:first-child {
    top: 18px;
  }

  .site-nav-toggle__bar:last-child {
    top: 24px;
  }

  .site-nav-toggle[aria-expanded="true"] .site-nav-toggle__bar:first-child {
    translate: 0 3px;
    rotate: 45deg;
  }

  .site-nav-toggle[aria-expanded="true"] .site-nav-toggle__bar:last-child {
    translate: 0 -3px;
    rotate: -45deg;
  }

  .site-nav-toggle:focus-visible {
    outline: 3px solid var(--color-brand);
    outline-offset: 2px;
  }

  :global(body.high-contrast) .site-header__inner {
    background: var(--color-card);
    border: 2px solid var(--color-hc-ink);
  }

  @media (max-width: 1080px) {
    .site-nav__link {
      padding: 10px 12px;
    }

    .site-header__actions .site-header__login {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .site-header {
      padding: 10px 12px 0;
    }

    .site-header__inner {
      padding: 6px 6px 6px 18px;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: calc(100% + 10px);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      padding: 12px;
      background: var(--color-card);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lift);
    }

    .site-nav.is-open {
      display: flex;
    }

    .site-nav__link {
      padding: 12px 16px;
      font-size: 1rem;
    }

    .site-nav__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 8px;
      padding-top: 12px;
      border-top: 1px solid color-mix(in srgb, var(--color-ink) 10%, transparent);
    }

    .site-nav__actions > * {
      flex: 1 1 auto;
      justify-content: center;
    }

    .site-nav-toggle {
      display: inline-block;
    }

    .site-header__actions .site-header__login,
    .site-header__actions :global(.site-header__cta) {
      display: none;
    }

    :global(body.high-contrast) .site-nav {
      border: 2px solid var(--color-hc-ink);
    }
  }
</style>
