---
/**
 * Shell for ported app pages: BaseLayout + Font Awesome + the global app
 * primitives (src/styles/app.css) + app chrome, and the legacy core
 * scripts the page still relies on (IIFE globals: Session, Store, Modal,
 * Toast, I18n, ...). Those scripts stay in public/ as classic (non-module)
 * scripts on purpose: guard.js must run synchronously in <head> to redirect
 * guests before the page renders, and Astro-processed scripts are always
 * deferred modules. They are emitted in the legacy order so the page's own
 * module script (bundled by Astro, deferred) finds the globals ready.
 *
 * App chrome (T8, visual-language): a fixed AppSidebar on the left
 * (>768px; icon rail 769-1099px), the page in <main>, and an optional right
 * rail. Phones get the slim AppHeader on top and the AppTabBar at the
 * bottom instead of the sidebar. The sidebar replaced the old AppFooter
 * (its links live in the sidebar fine print and the phone account menu).
 *
 * Columns: `shell="standard"` (default) is sidebar + main. `shell="rail"`
 * adds a right column filled by the `rail` slot (>=1280px; it stacks under
 * the page below that); passing a `rail` slot also selects it. The rail is
 * an <aside> inside <main>, after the page content.
 *
 * Slots: default (inside <main>), `rail`, `before-main` (between the
 * chrome and <main>, e.g. a breadcrumb) and `after-main` (after <main>:
 * modals, fixed bars).
 */
// BaseLayout first: its global CSS (tokens, reset, element typography) must
// precede app.css, whose responsive element rules override it.
import BaseLayout from "./BaseLayout.astro";
import "@fortawesome/fontawesome-free/css/all.min.css";
import "../../styles/app.css";
import AppChrome from "./app/AppChrome.astro";
import AppSiteFooter from "./app/AppSiteFooter.astro";
import AppTabBar from "./AppTabBar.astro";
import AuthHeader from "./AuthHeader.astro";
import { asset } from "../../lib/url";

/** Legacy core scripts under public/assets/scripts/core. */
export type LegacyScript =
  | "translations"
  | "i18n"
  | "session"
  | "store"
  | "modal"
  | "toast"
  | "guard"
  | "notif-badge";

/** "standard": sidebar + main. "rail": sidebar + main + right rail. */
export type AppShell = "standard" | "rail";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  mainClass?: string;
  /** "app": full navigation; "auth": logo-only header (auth page). */
  chrome?: "app" | "auth";
  /** Column layout for app chrome; defaults to "rail" when a `rail` slot is passed. */
  shell?: AppShell;
  /** Site links row at the end of <main> (AppSiteFooter); false hides it (chat). */
  footer?: boolean;
  scripts?: LegacyScript[];
}

const { title, description, bodyClass, mainClass, chrome = "app", shell, footer = true, scripts = [] } = Astro.props;

const isApp = chrome === "app";
const hasRail = Astro.slots.has("rail");
const layout: AppShell = shell ?? (hasRail ? "rail" : "standard");
const withRail = isApp && layout === "rail" && hasRail;

const bodyClasses = [isApp && "app-shell", withRail && "app-shell--rail", bodyClass].filter(Boolean).join(" ");
const mainClasses = [withRail && "app-shell__main--rail", mainClass].filter(Boolean).join(" ") || undefined;
// Static elements picked by variable (not conditional expressions) so the
// `before-main` / `after-main` slots forwarded into the same BaseLayout
// slots are not dropped. Fragment renders nothing for auth chrome.
const Top = isApp ? AppChrome : AuthHeader;
const Bottom = isApp ? AppTabBar : Fragment;
const SiteFooter = isApp && footer ? AppSiteFooter : Fragment;

// Canonical load order (matches the legacy pages). `defer` scripts run
// after parsing, before the page module and before DOMContentLoaded.
const ORDER: { name: LegacyScript; defer: boolean }[] = [
  { name: "translations", defer: true },
  { name: "i18n", defer: true },
  { name: "session", defer: false },
  { name: "store", defer: false },
  { name: "modal", defer: false },
  { name: "toast", defer: false },
  // Runs synchronously in <head>: redirects guests before the page renders.
  { name: "guard", defer: false },
  { name: "notif-badge", defer: true },
];
const legacy = ORDER.filter((s) => scripts.includes(s.name)).map((s) => ({
  src: asset(`scripts/core/${s.name}.js`),
  defer: s.defer,
}));
---

<BaseLayout title={title} description={description} bodyClass={bodyClasses || undefined} mainClass={mainClasses}>
  <Fragment slot="head">
    {
      legacy.map((s) =>
        s.defer ? <script is:inline defer src={s.src} /> : <script is:inline src={s.src} />,
      )
    }
  </Fragment>
  <Top slot="header" />
  <slot name="before-main" slot="header" />
  {
    withRail ? (
      <Fragment>
        <div class="app-shell__content">
          <slot />
        </div>
        <aside class="app-shell__rail" aria-label="Panel lateral">
          <slot name="rail" />
        </aside>
        <SiteFooter />
      </Fragment>
    ) : (
      <Fragment>
        <slot />
        <SiteFooter />
      </Fragment>
    )
  }
  <Bottom slot="footer" />
  <slot name="after-main" slot="footer" />
</BaseLayout>
