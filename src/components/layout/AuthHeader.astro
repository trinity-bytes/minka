---
/**
 * Minimal logo-only header of the auth page (port of the static
 * .auth-header in public/pages/auth.html + core/layout.css).
 */
import Logotype from "../brand/Logotype.astro";
import { url } from "../../lib/url";
---

<header class="auth-header">
  <div class="auth-header__container">
    <a href={url()} class="auth-header__logo" aria-label="Mink'a, inicio">
      <Logotype tone="ink" size={36} decorative />
    </a>
  </div>
</header>

<style>
  /* Flat tinted bar (no ink rule); high contrast restores the 2px rule. */
  .auth-header {
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--color-paper) 92%, transparent);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .auth-header__container {
    /* Same width as the auth split container so the logo lines up with it. */
    max-width: 1100px;
    margin: 0 auto;
    padding: var(--space-12) 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
  }

  .auth-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .auth-header__logo :global(.logotype) {
    height: 36px;
  }

  @media (max-width: 768px) {
    .auth-header__container {
      padding: var(--space-12) 16px;
    }

    .auth-header__logo :global(.logotype) {
      height: 30px;
    }
  }

  @media (max-width: 600px) {
    .auth-header__container {
      padding: var(--space-8) 16px;
    }
  }

  @media (max-width: 480px) {
    .auth-header__container {
      padding: var(--space-8) 12px;
    }

    .auth-header__logo :global(.logotype) {
      height: 26px;
    }
  }

  :global(body.high-contrast) .auth-header {
    border-bottom: var(--border-ink);
  }

  @media print {
    .auth-header {
      display: none !important;
    }
  }
</style>
