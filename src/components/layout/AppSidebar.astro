---
/**
 * Desktop app sidebar (>768px): logotype, primary nav with a dark ink
 * active pill, the unread counter on Notificaciones, the signed-in user
 * block (initials Avatar filled by app-shell.ts) with "Salir", and the
 * site links that used to live in AppFooter. 769-1099px it collapses to an
 * icon rail (labels stay in the accessibility tree). Hidden on phones,
 * where AppHeader + AppTabBar take over.
 */
import Logotype from "../brand/Logotype.astro";
import Logomark from "../brand/Logomark.astro";
import Avatar from "../ui/Avatar.astro";
import { LOGIN_HREF, SIDEBAR_ITEMS, SITE_LINKS, current } from "./app/nav";
import { url } from "../../lib/url";

const pathname = Astro.url.pathname;
---

<div class="app-sidebar" data-app-shell>
  <a href={url("pages/home.html")} class="app-sidebar__logo" aria-label="Mink'a, inicio">
    <Logotype tone="ink" size={34} decorative class="app-sidebar__wordmark" />
    <Logomark size={30} class="app-sidebar__mark" />
  </a>

  <nav class="app-sidebar__nav" aria-label="Navegación principal">
    <ul role="list">
      {
        SIDEBAR_ITEMS.map((item) => (
          <li data-show={item.authOnly ? "auth" : undefined}>
            <a
              href={item.href}
              class="app-sidebar__link"
              aria-current={current(item, pathname)}
              title={item.label}
            >
              <i class={`fa-solid ${item.icon}`} aria-hidden="true" />
              <span class="app-sidebar__label" data-i18n={item.i18n}>
                {item.label}
              </span>
              {item.unread && (
                <span class="app-badge is-hidden" data-unread-badge>
                  0
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="app-sidebar__account">
    <div class="app-sidebar__user" data-show="auth">
      <Avatar name="Tu cuenta" tone="mint" decorative data-user-avatar />
      <div class="app-sidebar__who">
        <span class="app-sidebar__name" data-user-name>Tu cuenta</span>
        <span class="app-sidebar__meta" data-user-meta></span>
      </div>
    </div>
    <a href={LOGIN_HREF} class="app-sidebar__link app-sidebar__logout" data-show="auth" data-action="logout" title="Salir">
      <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i>
      <span class="app-sidebar__label" data-i18n="nav_logout">Salir</span>
    </a>
    <a href={LOGIN_HREF} class="app-sidebar__link app-sidebar__login is-hidden" data-show="guest" title="Ingresar">
      <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>
      <span class="app-sidebar__label" data-i18n="nav_login">Ingresar</span>
    </a>
  </div>

  <nav class="app-sidebar__site" aria-label="Enlaces del sitio">
    <ul role="list">
      {SITE_LINKS.map((link) => <li>{link.href ? <a href={link.href}>{link.label}</a> : <span>{link.label}</span>}</li>)}
    </ul>
    <p>&copy; 2025 Mink'a. Trueque con propósito.</p>
  </nav>
</div>

<script>
  // Shared wiring for the sidebar, the phone header and the tab bar.
  import "../../scripts/app-shell";
</script>

<style>
  .app-sidebar {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: var(--z-overlay);
    width: var(--app-sidebar-w);
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-24) var(--space-16) var(--space-16);
    background: var(--color-card);
    border-inline-end: 1px solid var(--color-gray-100);
    overflow-y: auto;
    overscroll-behavior: contain;
    font-family: var(--font-primary);
  }

  .app-sidebar__logo {
    display: flex;
    align-items: center;
    padding: var(--space-4) var(--space-12) var(--space-12);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .app-sidebar__logo :global(.app-sidebar__wordmark) {
    height: 34px;
  }

  .app-sidebar__logo :global(.app-sidebar__mark) {
    display: none;
  }

  .app-sidebar ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .app-sidebar__nav ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .app-sidebar__link {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-12);
    min-height: 44px;
    padding: 10px 14px;
    border-radius: var(--radius-full);
    color: var(--color-ink-2);
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--dur-fast) var(--ease-standard),
      color var(--dur-fast) var(--ease-standard);
  }

  .app-sidebar__link i {
    width: 20px;
    font-size: 1.05rem;
    text-align: center;
    flex-shrink: 0;
  }

  .app-sidebar__link:hover {
    background: var(--color-bg);
    color: var(--color-ink);
  }

  /* Dark ink active pill; a section page (aria-current="true") gets mint. */
  .app-sidebar__link[aria-current="page"] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .app-sidebar__link[aria-current="true"] {
    background: var(--color-mint);
    color: var(--color-ink);
  }

  .app-sidebar__link:focus-visible,
  .app-sidebar__logo:focus-visible,
  .app-sidebar__site a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .app-badge {
    margin-inline-start: auto;
  }

  /* === Account block === */
  .app-sidebar__account {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-16);
    border-top: 1px solid var(--color-gray-100);
  }

  .app-sidebar__user {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    padding: var(--space-8) var(--space-12);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    min-width: 0;
  }

  .app-sidebar__who {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .app-sidebar__name {
    font-weight: 700;
    color: var(--color-ink);
    font-size: 0.92rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-sidebar__meta {
    font-size: 0.8rem;
    color: var(--color-gray-600);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .app-sidebar__meta:empty {
    display: none;
  }

  .app-sidebar__logout {
    color: var(--color-error-ink);
  }

  .app-sidebar__logout:hover {
    color: var(--color-error-ink);
    background: color-mix(in srgb, var(--color-error) 10%, transparent);
  }

  .app-sidebar__login {
    color: var(--color-primary);
    box-shadow: inset 0 0 0 1.5px currentColor;
  }

  /* === Site links (former AppFooter) === */
  .app-sidebar__site {
    padding: 0 var(--space-12);
    font-size: 0.78rem;
    color: var(--color-gray-600);
  }

  .app-sidebar__site ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2px var(--space-12);
  }

  .app-sidebar__site a {
    color: var(--color-gray-600);
    text-decoration: underline;
    text-underline-offset: 3px;
    border-radius: 4px;
  }

  .app-sidebar__site a:hover {
    color: var(--color-ink);
  }

  .app-sidebar__site p {
    margin: var(--space-8) 0 0;
    font-size: inherit;
    color: inherit;
  }

  /* === Compact icon rail (tablet) === */
  @media (max-width: 1099px) {
    .app-sidebar {
      padding-inline: var(--space-12);
      align-items: center;
    }

    .app-sidebar__logo {
      padding: var(--space-4) 0 var(--space-12);
    }

    .app-sidebar__logo :global(.app-sidebar__wordmark) {
      display: none;
    }

    .app-sidebar__logo :global(.app-sidebar__mark) {
      display: block;
      height: 30px;
      width: auto;
    }

    .app-sidebar__nav,
    .app-sidebar__account {
      width: 100%;
    }

    .app-sidebar__link {
      justify-content: center;
      padding: 12px;
    }

    .app-sidebar__label,
    .app-sidebar__who {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .app-sidebar__user {
      justify-content: center;
      padding: var(--space-4);
      background: none;
    }

    .app-badge {
      position: absolute;
      top: 2px;
      inset-inline-end: 2px;
      font-size: 0.68rem;
    }

    .app-sidebar__site {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .app-sidebar {
      display: none;
    }
  }

  /* === High contrast / forced colors === */
  :global(body.high-contrast) .app-sidebar {
    background: var(--color-hc-paper);
    border-inline-end: 2px solid var(--color-hc-ink);
  }

  :global(body.high-contrast) .app-sidebar__link[aria-current] {
    background: var(--color-hc-paper);
    outline: 2px solid var(--color-hc-ink);
    outline-offset: -2px;
    font-weight: 800;
  }

  :global(body.high-contrast) .app-sidebar__link:focus-visible {
    outline: 2px solid var(--color-hc-ink);
    outline-offset: 2px;
  }

  @media (forced-colors: active) {
    .app-sidebar__link[aria-current] {
      outline: 2px solid CanvasText;
      outline-offset: -2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-sidebar__link {
      transition: none;
    }
  }

  @media print {
    .app-sidebar {
      display: none !important;
    }
  }
</style>
