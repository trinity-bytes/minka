---
/**
 * Slim app header for phones (<=768px): logotype, Notificaciones (unread
 * counter) and Chats shortcuts, and an account menu (Perfil, Acerca de,
 * Salir / Ingresar) since "Salir" left the main nav. On wider screens
 * AppSidebar carries the whole nav, so this header is not rendered there
 * (no duplicated nav). Session, logout and the menu are wired by
 * src/scripts/app-shell.ts.
 */
import Logotype from "../brand/Logotype.astro";
import Avatar from "../ui/Avatar.astro";
import { HEADER_ITEMS, LOGIN_HREF, SITE_LINKS, current } from "./app/nav";
import { url } from "../../lib/url";

const pathname = Astro.url.pathname;
const about = SITE_LINKS[0];
---

<header class="app-header" data-app-shell>
  <div class="app-header__bar">
    <a href={url("pages/home.html")} class="app-header__logo" aria-label="Mink'a, inicio">
      <Logotype tone="ink" size={28} decorative />
    </a>

    <nav class="app-header__quick" aria-label="Accesos rápidos">
      <ul role="list">
        {
          HEADER_ITEMS.map((item) => (
            <li data-show={item.authOnly ? "auth" : undefined}>
              <a href={item.href} class="app-header__icon-btn" aria-current={current(item, pathname)}>
                <i class={`fa-solid ${item.icon}`} aria-hidden="true" />
                <span class="sr-only" data-i18n={item.i18n}>
                  {item.label}
                </span>
                {item.unread && (
                  <span class="app-badge app-header__badge is-hidden" data-unread-badge>
                    0
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="app-header__account">
      <button
        type="button"
        class="app-header__account-btn"
        aria-expanded="false"
        aria-controls="app-account-menu"
        data-account-toggle
      >
        <Avatar name="Tu cuenta" tone="mint" size="sm" decorative data-user-avatar />
        <span class="sr-only">Mi cuenta</span>
      </button>
      <div class="app-header__menu" id="app-account-menu" data-account-menu hidden>
        <p class="app-header__menu-name" data-show="auth" data-user-name>Tu cuenta</p>
        <ul role="list">
          <li data-show="auth">
            <a href={url("pages/perfil.html")} data-i18n="nav_profile">Perfil</a>
          </li>
          <li>
            <a href={about.href}>{about.label}</a>
          </li>
          <li data-show="auth">
            <a href={LOGIN_HREF} class="app-header__logout" data-action="logout" data-i18n="nav_logout">Salir</a>
          </li>
          <li data-show="guest" class="is-hidden">
            <a href={LOGIN_HREF} data-i18n="nav_login">Ingresar</a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</header>

<style>
  .app-header {
    display: none;
  }

  @media (max-width: 768px) {
    .app-header {
      display: block;
      position: sticky;
      top: 0;
      z-index: var(--z-overlay);
      background: color-mix(in srgb, var(--color-card) 94%, transparent);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--color-gray-100);
      font-family: var(--font-primary);
    }
  }

  .app-header__bar {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    min-height: 56px;
    padding: 6px 16px;
  }

  .app-header__logo {
    display: flex;
    align-items: center;
    margin-inline-end: auto;
    border-radius: var(--radius-sm);
  }

  .app-header__logo :global(.logotype) {
    height: 28px;
  }

  .app-header__quick ul {
    display: flex;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .app-header__icon-btn,
  .app-header__account-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    color: var(--color-ink);
    font-size: 1.1rem;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .app-header__icon-btn:hover {
    background: var(--color-bg);
  }

  .app-header__icon-btn[aria-current] {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .app-header__badge {
    position: absolute;
    top: 2px;
    inset-inline-end: 0;
    font-size: 0.66rem;
  }

  .app-header__icon-btn:focus-visible,
  .app-header__account-btn:focus-visible,
  .app-header__logo:focus-visible,
  .app-header__menu a:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* === Account menu === */
  .app-header__account {
    position: relative;
  }

  .app-header__menu {
    position: absolute;
    top: calc(100% + 8px);
    inset-inline-end: 0;
    min-width: 200px;
    padding: var(--space-8);
    background: var(--color-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    border: 1px solid var(--color-gray-100);
  }

  .app-header__menu[hidden] {
    display: none;
  }

  .app-header__menu-name {
    margin: 0;
    padding: var(--space-8) var(--space-12);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-gray-100);
    margin-bottom: var(--space-4);
  }

  .app-header__menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .app-header__menu a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-12);
    border-radius: var(--radius-md);
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .app-header__menu a:hover {
    background: var(--color-bg);
  }

  .app-header__menu .app-header__logout {
    color: var(--color-error-ink);
  }

  /* === High contrast / forced colors === */
  :global(body.high-contrast) .app-header {
    background: var(--color-hc-paper);
    border-bottom: 2px solid var(--color-hc-ink);
  }

  :global(body.high-contrast) .app-header__icon-btn[aria-current] {
    background: var(--color-hc-paper);
    outline: 2px solid var(--color-hc-ink);
  }

  :global(body.high-contrast) .app-header__menu {
    border: 2px solid var(--color-hc-ink);
    box-shadow: none;
  }

  @media (forced-colors: active) {
    .app-header__icon-btn[aria-current] {
      outline: 2px solid CanvasText;
    }

    .app-header__menu {
      border: 2px solid CanvasText;
    }
  }

  @media print {
    .app-header {
      display: none !important;
    }
  }
</style>
