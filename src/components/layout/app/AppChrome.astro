---
/**
 * Top-of-body app chrome as one static element, so AppLayout can pick it
 * with a component variable (a conditional expression next to the
 * forwarded `before-main` slot would drop that slot). Slim phone header
 * first in DOM order, then the sidebar.
 */
import AppHeader from "../AppHeader.astro";
import AppSidebar from "../AppSidebar.astro";
---

<AppHeader />
<AppSidebar />
