---
/**
 * Landing footer: brand blurb, link columns, copyright and social links.
 * Entries without an `href` (no destination exists yet) render as plain
 * text instead of dead `#` links. Other public pages (about) pass
 * `anchorBase={url()}` so `#anchor` links point back to the landing.
 */
import Icon, { type IconName } from "../ui/Icon.astro";
import { Image } from "astro:assets";
import { url } from "../../lib/url";
import logoNegative from "../../assets/images/minka-logo-negativo-blanco.png";

interface FooterLink {
  href?: string;
  label: string;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

interface Props {
  homeHref?: string;
  columns?: FooterColumn[];
  /** Prefix for `#anchor` links when rendered outside the landing. */
  anchorBase?: string;
}

const {
  anchorBase = "",
  columns = [
    {
      title: "Plataforma",
      links: [
        { href: "#como-funciona", label: "Cómo funciona" },
        { href: "#beneficios", label: "Beneficios" },
        { href: "#plataforma", label: "La app" },
        { href: "#testimonios", label: "Comunidad" },
      ],
    },
    {
      title: "Empresa",
      links: [
        { href: url("pages/about.html"), label: "Sobre nosotros" },
        { label: "Contacto" },
        { label: "Prensa" },
        { label: "Carreras" },
      ],
    },
    {
      title: "Legal",
      links: [
        { label: "Términos de servicio" },
        { label: "Privacidad" },
        { label: "Cookies" },
        { label: "Accesibilidad" },
      ],
    },
  ],
} = Astro.props;

const withBase = (href?: string) => (href?.startsWith("#") ? `${anchorBase}${href}` : href);
const homeHref = withBase(Astro.props.homeHref ?? "#inicio");
const footerColumns = columns.map((column) => ({
  ...column,
  links: column.links.map((link) => ({ ...link, href: withBase(link.href) })),
}));

// No official social accounts exist yet: icons render without a link.
const social: { icon: IconName; label: string; href?: string }[] = [
  { icon: "facebook", label: "Facebook" },
  { icon: "instagram", label: "Instagram" },
  { icon: "x", label: "X (antes Twitter)" },
  { icon: "linkedin", label: "LinkedIn" },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div>
        <a href={homeHref} class="site-footer__logo" aria-label="Mink'a, inicio">
          <Image src={logoNegative} width={139} densities={[1, 2]} alt="Mink'a" />
        </a>
        <p class="site-footer__desc">
          Plataforma de trueque para economía circular. Construyendo una Lima más sostenible, un
          intercambio a la vez.
        </p>
      </div>
      {
        footerColumns.map((column) => (
          <div>
            <h3 class="site-footer__title">{column.title}</h3>
            <ul class="site-footer__links">
              {column.links.map((link) => (
                <li>{link.href ? <a href={link.href}>{link.label}</a> : <span>{link.label}</span>}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="site-footer__bottom">
      <p class="site-footer__copy">© 2025 Mink'a. Todos los derechos reservados.</p>
      <div class="site-footer__social">
        {
          social.map((item) =>
            item.href ? (
              <a href={item.href} aria-label={item.label} class="site-footer__social-item">
                <Icon name={item.icon} class="site-footer__icon" />
              </a>
            ) : (
              <span class="site-footer__social-item">
                <Icon name={item.icon} label={item.label} class="site-footer__icon" />
              </span>
            ),
          )
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink-deep);
    color: var(--color-paper);
    padding: 80px 0 36px;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 44px;
    padding-bottom: 52px;
  }

  .site-footer__logo img {
    height: 54px;
    width: auto;
    display: block;
    margin-bottom: 18px;
  }

  .site-footer__desc {
    color: color-mix(in srgb, var(--color-paper) 65%, transparent);
    font-size: 0.98rem;
    max-width: 300px;
    margin: 0;
  }

  .site-footer__title {
    font-family: var(--font-primary);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-primary-pop);
    margin: 0 0 18px;
  }

  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__links a,
  .site-footer__links span {
    color: color-mix(in srgb, var(--color-paper) 72%, transparent);
    font-size: 0.96rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .site-footer__links a:hover,
  .site-footer__links a:focus-visible {
    color: var(--color-primary-pop);
  }

  .site-footer__bottom {
    border-top: 1px solid color-mix(in srgb, var(--color-paper) 14%, transparent);
    padding-top: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .site-footer__copy {
    margin: 0;
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--color-paper) 55%, transparent);
  }

  .site-footer__social {
    display: flex;
    gap: 12px;
  }

  .site-footer__social-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1.5px solid color-mix(in srgb, var(--color-paper) 30%, transparent);
    border-radius: 50%;
    color: var(--color-paper);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  a.site-footer__social-item:hover,
  a.site-footer__social-item:focus-visible {
    background: var(--color-primary-pop);
    border-color: var(--color-primary-pop);
    color: var(--color-on-brand);
    transform: translateY(-3px);
  }

  .site-footer__social .site-footer__icon {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 1024px) {
    .site-footer__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .site-footer__bottom {
      justify-content: center;
      text-align: center;
    }
  }
</style>
