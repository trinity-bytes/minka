---
/**
 * Featured community challenge card for the home rail (demo data from the
 * community page): icon chip, title, text, progress and a link to the
 * challenges.
 */
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import IconChip from "../ui/IconChip.astro";
import { url } from "../../lib/url";

interface Props {
  progress?: number;
}

const { progress = 75 } = Astro.props;
---

<Card as="section" tone="mint" class="home-challenge" aria-label="Reto comunitario destacado">
  <IconChip tone="lavender" class="home-challenge__icon">
    <i class="fas fa-book-open"></i>
  </IconChip>
  <div class="home-challenge__text">
    <h2 data-i18n="home_challenge_title">Reto del mes: Semana del Libro</h2>
    <p data-i18n="home_challenge_text">
      Tu distrito ya completó el 75% de la meta. Intercambia libros y suma puntos.
    </p>
    <div
      class="home-challenge__bar"
      role="progressbar"
      aria-valuenow={progress}
      aria-valuemin="0"
      aria-valuemax="100"
      aria-label="Avance del reto"
    >
      <div class="home-challenge__fill" style={`width: ${progress}%`}></div>
    </div>
  </div>
  <Button
    href={url("pages/comunidad.html")}
    appearance="flat"
    variant="ink"
    class="home-challenge__cta"
    data-i18n="home_challenge_cta"
  >
    Ver retos
  </Button>
</Card>
