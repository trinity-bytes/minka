---
/**
 * One tile of the home impact card: icon chip, value and label.
 * `valueId` lets src/scripts/pages/home.js hydrate the value from Store.
 */
import IconChip from "../ui/IconChip.astro";

interface Props {
  icon: string;
  tone: "primary" | "success" | "warning" | "info";
  value: string;
  valueId?: string;
  label: string;
  labelKey: string;
}

const { icon, tone, value, valueId, label, labelKey } = Astro.props;

// Legacy tones mapped onto the visual-language chip fills (text-safe pairs).
const CHIP_TONE = {
  primary: "brand",
  success: "mint",
  warning: "lavender",
  info: "ink",
} as const;
---

<div class="impact-stat">
  <IconChip tone={CHIP_TONE[tone]} size="sm" class="impact-stat__icon">
    <i class={`fas ${icon}`}></i>
  </IconChip>
  <div class="impact-stat__content">
    <span class="impact-stat__value" id={valueId}>{value}</span>
    <span class="impact-stat__label" data-i18n={labelKey}>{label}</span>
  </div>
</div>
