---
/**
 * One notification preference row: visible label + on/off switch
 * (ui/Toggle, `.switch` styled in src/styles/app.css; row layout in
 * src/styles/pages/notifications.css). notifications.js reads and persists
 * the checkbox by its id; the `for` label names the switch.
 */
import Toggle from "../ui/Toggle.astro";

interface Props {
  id: string;
  label: string;
  /** i18n key for the label (legacy I18n runtime). */
  labelKey?: string;
  checked?: boolean;
}

const { id, label, labelKey, checked = false } = Astro.props;
---

<div class="pref-toggle">
  <label for={id} data-i18n={labelKey}>{label}</label>
  <Toggle id={id} checked={checked} />
</div>
