---
/**
 * Notification center: feed with read/remove actions, type and unread
 * filters, and notification preferences (right rail). Port of
 * public/pages/notificaciones.html.
 * T22 - Miguel Sanca: notification feed and preferences.
 * Logic: src/scripts/pages/notifications.js (guarded: requires a session).
 * It persists the feed through Store (`minka_notifications`) and fires
 * `minka-feed-update`, which core/notif-badge.js listens to in order to
 * refresh the header unread badge.
 *
 * Type filter (T10a): notifications.js reads `#filter-type` (value +
 * change event). The visible control is a pill button group; the inline
 * script below mirrors the pressed pill into that hidden select and fires
 * its change event, so the feed logic is untouched.
 */
import AppLayout from "../../components/layout/AppLayout.astro";
import Button from "../../components/ui/Button.astro";
import Card from "../../components/ui/Card.astro";
import CardSection from "../../components/ui/CardSection.astro";
import PageHead from "../../components/ui/PageHead.astro";
import Toggle from "../../components/ui/Toggle.astro";
import PrefToggle from "../../components/notifications/PrefToggle.astro";
import "../../styles/pages/notifications.css";

const TYPE_FILTERS = [
  { value: "all", label: "Todos los tipos", key: "notif_filter_all" },
  { value: "message", label: "Mensajes", key: "notif_filter_message" },
  { value: "match", label: "Coincidencias", key: "notif_filter_match" },
  { value: "reminder", label: "Recordatorios", key: "notif_filter_reminder" },
];

const PREFS = [
  { id: "pref-messages", label: "Mensajes y actividad de chat", key: "notif_pref_messages", checked: true },
  { id: "pref-matches", label: "Coincidencias y sugerencias", key: "notif_pref_matches", checked: true },
  { id: "pref-reminders", label: "Recordatorios de encuentro", key: "notif_pref_reminders", checked: true },
  { id: "pref-reviews", label: "Reseñas y reputación", key: "notif_pref_reviews" },
  { id: "pref-news", label: "Novedades y tips", key: "notif_pref_news" },
];

const TIPS = [
  { text: "• Confirma el punto de encuentro dentro del chat.", key: "notif_tip_1" },
  { text: "• Marca recordatorios para llegar a tiempo.", key: "notif_tip_2" },
  { text: "• Reporta actividad inusual desde la ficha de detalle.", key: "notif_tip_3" },
];
---

<AppLayout
  title="Mink'a - Notificaciones"
  description="Avisos de mensajes, coincidencias y recordatorios de entrega en Mink'a."
  bodyClass="notifications-page"
  mainClass="notifications-main"
  scripts={["translations", "i18n", "session", "store", "modal", "toast", "guard", "notif-badge"]}
>
  <PageHead
    title="Notificaciones y recordatorios"
    titleKey="notif_title"
    subtitle="Consulta avisos de mensajes, coincidencias y recordatorios de entrega. Configura tus preferencias para recibir solo lo necesario."
    subtitleKey="notif_subtitle"
  />

  <section class="container notifications-layout" aria-label="Centro de notificaciones">
    <Card as="section" class="feed-card" aria-label="Lista de notificaciones">
      <div class="card__header feed-card__header">
        <div class="feed-header__top">
          <h2 data-i18n="notif_tray_title">Tu bandeja</h2>
          <div class="feed-actions">
            <Button appearance="flat" variant="primary" size="sm" id="mark-all-read" data-i18n="notif_btn_mark_all">
              Marcar todo
            </Button>
            <Button appearance="flat" variant="secondary" size="sm" id="clear-read" data-i18n="notif_btn_clear_read">
              Borrar leídas
            </Button>
          </div>
        </div>
        <div class="feed-filters">
          <select id="filter-type" aria-label="Filtrar por tipo" hidden>
            {TYPE_FILTERS.map((f) => <option value={f.value} data-i18n={f.key}>{f.label}</option>)}
          </select>
          <div class="pill-tabs feed-type-filter" role="group" aria-label="Filtrar por tipo" data-type-filter>
            {
              TYPE_FILTERS.map((f, i) => (
                <button
                  type="button"
                  class="pill-tabs__tab"
                  aria-pressed={i === 0 ? "true" : "false"}
                  data-value={f.value}
                  data-i18n={f.key}
                >
                  {f.label}
                </button>
              ))
            }
          </div>
          <div class="feed-unread">
            <label for="filter-unread" data-i18n="notif_pref_unread">Solo no leídas</label>
            <Toggle id="filter-unread" checked />
          </div>
        </div>
      </div>
      <div class="card__body" id="notifications-list" aria-live="polite"></div>
    </Card>
  </section>

  <Fragment slot="rail">
    <CardSection
      class="prefs__card"
      aria-label="Preferencias de notificación"
      title="Preferencias"
      titleKey="notif_prefs_title"
      level={2}
    >
      {PREFS.map((p) => <PrefToggle id={p.id} label={p.label} labelKey={p.key} checked={p.checked} />)}
      <div class="pref-select">
        <label for="pref-quiet" data-i18n="notif_pref_quiet">Horario silencioso</label>
        <select id="pref-quiet">
          <option value="none" data-i18n="notif_quiet_none">Sin silencio</option>
          <option value="21-7">21:00 - 07:00</option>
          <option value="22-6">22:00 - 06:00</option>
        </select>
      </div>
    </CardSection>

    <CardSection
      class="prefs__card"
      aria-label="Consejos de seguridad"
      title="Consejos rápidos"
      titleKey="notif_tips_title"
      level={2}
      bodyClass="tips"
    >
      {TIPS.map((t) => <p data-i18n={t.key}>{t.text}</p>)}
    </CardSection>
  </Fragment>

  <script>
    import "../../scripts/pages/notifications.js";

    // Pill group -> hidden #filter-type (read by notifications.js).
    const select = document.getElementById("filter-type") as HTMLSelectElement | null;
    const group = document.querySelector<HTMLElement>("[data-type-filter]");
    group?.addEventListener("click", (event) => {
      const pill = (event.target as Element).closest<HTMLButtonElement>("button[data-value]");
      if (!pill || !select) return;
      group.querySelectorAll("button[data-value]").forEach((button) => {
        button.setAttribute("aria-pressed", String(button === pill));
      });
      if (select.value === pill.dataset.value) return;
      select.value = pill.dataset.value ?? "all";
      select.dispatchEvent(new Event("change"));
    });
  </script>
</AppLayout>
