---
/**
 * Listing detail: gallery, description, owner, facts, exchange QR, item
 * timeline, owner/visitor actions and similar listings. Port of
 * public/pages/detalle.html.
 * T25 - Ronel Rojas: environmental metrics when a trade closes.
 * T31 - Andy Salcedo: location sharing and distance.
 * T33 - Miguel Sanca: item timeline, QR reissue and offline close.
 * Logic: src/scripts/pages/detail.js (guarded: requires a session).
 */
import AppLayout from "../../components/layout/AppLayout.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Button from "../../components/ui/Button.astro";
import Gallery from "../../components/detail/Gallery.astro";
import ReactionBar from "../../components/detail/ReactionBar.astro";
import SellerCard from "../../components/detail/SellerCard.astro";
import QrPassDialog from "../../components/detail/QrPassDialog.astro";
import OfflineModal from "../../components/detail/OfflineModal.astro";
import RatingModal from "../../components/exchange/RatingModal.astro";
import ReportModal from "../../components/exchange/ReportModal.astro";
import CloseReasonModal from "../../components/detail/CloseReasonModal.astro";
import EcoModal from "../../components/detail/EcoModal.astro";
import { url } from "../../lib/url";
import "../../styles/pages/detail.css";

// Panel facts; the specs detail.js appends (Marca, Modelo, Color) join
// these rows inside `.detail-info`.
const FACTS = [
  { label: "Disponibilidad", id: "item-availability" },
  { label: "Ubicación", id: "item-location" },
];

// Standard product page (T10d-1): gallery left; the listing content sits
// unboxed on the page to its right (meta line, title, condition,
// description, inline actions), then ONE neutral panel groups the exchange
// options, then the CTA row and the owner line. The item history follows
// below; the exchange pass opens in a dialog from the CTA row (T10d-5).
---

<AppLayout
  title="Mink'a - Detalle de publicación"
  description="Ficha de una publicación de trueque en Mink'a: fotos, estado, ubicación y QR de intercambio."
  bodyClass="detail-page"
  mainClass="detail-main"
  scripts={["translations", "i18n", "session", "store", "modal", "toast", "guard", "notif-badge"]}
>
  <Breadcrumb
    slot="before-main"
    items={[
      { label: "Inicio", href: url("pages/home.html"), key: "nav_home" },
      { label: "Búsqueda", href: url("pages/busqueda.html"), key: "nav_search" },
      { label: "Detalle", id: "breadcrumb-current" },
    ]}
  />

  <section class="container product" aria-label="Ficha de publicación">
    <div class="product__media">
      <Gallery />
    </div>

    <article class="product__info" aria-labelledby="item-title">
      <div class="product__meta">
        <p class="detail-hero__eyebrow">Publicación activa</p>
        <span class="product__rating">
          <span class="sr-only">Reputación:</span>
          <span id="item-rating">—</span>
        </span>
        <span class="product__meta-text" id="item-meta">Categoría · Ubicación</span>
      </div>

      <h1 id="item-title">Título del ítem</h1>
      <p class="product__lead">
        <strong id="item-condition">—</strong>
        <span aria-hidden="true">·</span>
        <span>Para trueque</span>
      </p>

      <div class="product__description detail-description">
        <h2 class="sr-only" id="description-title" data-i18n="detail_description">Descripción</h2>
        <p id="item-description">
          Descripción del objeto. Se actualizará con datos simulados en el script.
        </p>
        <div class="tag-list" id="item-tags"></div>
      </div>

      <ReactionBar />

      <!-- The page's one grouped panel: how the exchange happens + facts. -->
      <section class="product__panel" aria-labelledby="summary-title">
        <h2 class="sr-only" id="summary-title">Opciones de intercambio</h2>
        <div class="product__group">
          <h3 class="product__label">Modo de entrega</h3>
          <ul class="mode-list" id="item-modes" role="list">
            <li class="mode-pill">A coordinar por chat</li>
          </ul>
        </div>
        <div class="product__group">
          <h3 class="product__label">Ficha del objeto</h3>
          <div class="detail-info">
            {
              FACTS.map((f) => (
                <div class="info-row">
                  <span>{f.label}</span>
                  <strong id={f.id}>—</strong>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <div class="detail-cta">
        <Button
          appearance="flat"
          variant="primary"
          size="lg"
          href={url("pages/chat.html")}
          id="action-contact"
          data-i18n="detail_contact">Contactar</Button
        >
        <Button
          appearance="flat"
          variant="secondary"
          size="lg"
          id="qr-pass-open"
          aria-haspopup="dialog"
          aria-controls="qr-dialog"
        >
          <i class="fas fa-qrcode" aria-hidden="true"></i>
          <span>Ver pase QR</span>
        </Button>
      </div>

      <SellerCard />
    </article>
  </section>

  <!-- Below the product: the item history (T33). The exchange pass opens in
       a dialog from the CTA row (T10d-5). -->
  <section class="container detail-more" aria-label="Historial del objeto">
    <section class="detail-timeline" aria-labelledby="timeline-title">
      <h2 id="timeline-title" data-i18n="detail_timeline_title">Historial del Objeto</h2>
      <ul class="timeline" id="item-timeline"></ul>
    </section>
  </section>

  <!-- Chunk 4.8: Similares de la misma categoría -->
  <section class="container similar-section" id="similar-section" aria-label="Publicaciones similares" hidden>
    <h2 data-i18n="detail_similar">Similares</h2>
    <div class="similar-grid" id="similar-grid"></div>
  </section>

  <Fragment slot="after-main">
    <!-- Chunk 4.8: CTA fija en móvil -->
    <div class="sticky-cta" id="sticky-cta" hidden>
      <span class="sticky-cta__mode" id="sticky-cta-mode"></span>
      <Button
        appearance="flat"
        variant="primary"
        href={url("pages/chat.html")}
        id="sticky-cta-contact"
        data-i18n="detail_contact">Contactar</Button
      >
    </div>
    <QrPassDialog />
    <OfflineModal />
    <RatingModal />
    <ReportModal />
    <CloseReasonModal />
    <EcoModal />
  </Fragment>

  <script>
    import "../../scripts/pages/detail.js";
  </script>
</AppLayout>
