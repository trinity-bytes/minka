---
/**
 * Listing detail: gallery, description, owner, facts, exchange QR, item
 * timeline, owner/visitor actions and similar listings. Port of
 * public/pages/detalle.html.
 * T25 - Ronel Rojas: environmental metrics when a trade closes.
 * T31 - Andy Salcedo: location sharing and distance.
 * T33 - Miguel Sanca: item timeline, QR reissue and offline close.
 * Logic: src/scripts/pages/detail.js (guarded: requires a session).
 */
import AppLayout from "../../components/layout/AppLayout.astro";
import Breadcrumb from "../../components/ui/Breadcrumb.astro";
import Button from "../../components/ui/Button.astro";
import Gallery from "../../components/detail/Gallery.astro";
import ReactionBar from "../../components/detail/ReactionBar.astro";
import SellerCard from "../../components/detail/SellerCard.astro";
import QrCard from "../../components/detail/QrCard.astro";
import OfflineModal from "../../components/detail/OfflineModal.astro";
import RatingModal from "../../components/exchange/RatingModal.astro";
import ReportModal from "../../components/exchange/ReportModal.astro";
import CloseReasonModal from "../../components/detail/CloseReasonModal.astro";
import EcoModal from "../../components/detail/EcoModal.astro";
import { url } from "../../lib/url";
import "../../styles/pages/detail.css";

const FACTS = [
  { label: "Estado", id: "item-condition" },
  { label: "Ubicación", id: "item-location" },
  { label: "Disponibilidad", id: "item-availability" },
  { label: "Reputación", id: "item-rating" },
];

// Specs appended by detail.js (Marca, Modelo, Color) join these rows.
// Actions live in the reaction bar under the gallery (ReactionBar); the
// decision panel keeps one primary action, "Contactar" (T10c-1).
---

<AppLayout
  title="Mink'a - Detalle de publicación"
  description="Ficha de una publicación de trueque en Mink'a: fotos, estado, ubicación y QR de intercambio."
  bodyClass="detail-page"
  mainClass="detail-main"
  scripts={["translations", "i18n", "session", "store", "modal", "toast", "guard", "notif-badge"]}
>
  <Breadcrumb
    slot="before-main"
    items={[
      { label: "Inicio", href: url("pages/home.html"), key: "nav_home" },
      { label: "Búsqueda", href: url("pages/busqueda.html"), key: "nav_search" },
      { label: "Detalle", id: "breadcrumb-current" },
    ]}
  />

  <section class="container detail-hero">
    <p class="detail-hero__eyebrow">Publicación activa</p>
    <h1 id="item-title">Título del ítem</h1>
    <p class="detail-hero__meta" id="item-meta">Categoría · Ubicación · Estado</p>
  </section>

  <!-- Two zones (T10c-1): the listing tells the item story on one white
       surface; the tinted decision panel holds facts, the only primary
       action, the owner and the exchange pass. -->
  <section class="detail-layout" aria-label="Ficha de publicación">
    <div class="container detail-grid">
      <article class="listing" aria-labelledby="item-title">
        <div class="listing__media">
          <Gallery />
          <ReactionBar />
        </div>

        <section class="listing__section detail-description" aria-labelledby="description-title">
          <h2 id="description-title" data-i18n="detail_description">Descripción</h2>
          <p id="item-description">
            Descripción del objeto. Se actualizará con datos simulados en el script.
          </p>
          <div class="tag-list" id="item-tags"></div>
        </section>

        <!-- T33 - Miguel Sanca: Historial de Trazabilidad (HU40) -->
        <section class="listing__section detail-timeline" aria-labelledby="timeline-title">
          <h2 id="timeline-title" data-i18n="detail_timeline_title">Historial del Objeto</h2>
          <ul class="timeline" id="item-timeline"></ul>
        </section>
      </article>

      <aside class="decision" aria-label="Resumen y acciones">
        <section class="detail-summary decision__section" aria-labelledby="summary-title">
          <h2 class="decision__label" id="summary-title">Ficha del objeto</h2>
          <div class="detail-info">
            {
              FACTS.map((f) => (
                <div class="info-row">
                  <span>{f.label}</span>
                  <strong id={f.id}>—</strong>
                </div>
              ))
            }
          </div>
          <div class="detail-cta">
            <Button
              appearance="flat"
              variant="primary"
              size="lg"
              href={url("pages/chat.html")}
              id="action-contact"
              data-i18n="detail_contact">Contactar</Button
            >
          </div>
        </section>

        <SellerCard />

        <QrCard />
      </aside>
    </div>
  </section>

  <!-- Chunk 4.8: Similares de la misma categoría -->
  <section class="container similar-section" id="similar-section" aria-label="Publicaciones similares" hidden>
    <h2 data-i18n="detail_similar">Similares</h2>
    <div class="similar-grid" id="similar-grid"></div>
  </section>

  <Fragment slot="after-main">
    <!-- Chunk 4.8: CTA fija en móvil -->
    <div class="sticky-cta" id="sticky-cta" hidden>
      <span class="sticky-cta__mode" id="sticky-cta-mode"></span>
      <Button
        appearance="flat"
        variant="primary"
        href={url("pages/chat.html")}
        id="sticky-cta-contact"
        data-i18n="detail_contact">Contactar</Button
      >
    </div>
    <OfflineModal />
    <RatingModal />
    <ReportModal />
    <CloseReasonModal />
    <EcoModal />
  </Fragment>

  <script>
    import "../../scripts/pages/detail.js";
  </script>
</AppLayout>
